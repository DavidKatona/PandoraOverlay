<Window x:Class="PandoraOverlay.UpdateCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora Overlay update"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <!-- The update card (1.32): the Settings dialog's frame and button looks,
         kept local like the sign-in window's (each dialog's resources are its
         own). Fixed size, the owner's call: the notes box scrolls instead of
         the card growing. -->
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E5E38"/>
            <Setter Property="Foreground" Value="#DFF3E2"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A7347"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E2A22"/>
                                <Setter Property="Foreground" Value="#5E7263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A3038"/>
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A4250"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E242B"/>
                                <Setter Property="Foreground" Value="#5E6B76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#552B2B"/>
            <Setter Property="Foreground" Value="#FFDDDD"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#6E3838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A2022"/>
                                <Setter Property="Foreground" Value="#6E5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#1A2129" CornerRadius="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#5E6B76" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Maximum, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Opacity" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F210151B" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16,14">
        <StackPanel>
            <!-- Header: icon, what this card is, ✕ (= Later). Draggable. -->
            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="&#x2715;" Click="Close_Click"
                        Style="{StaticResource CloseButtonStyle}" Width="22" Height="22" FontSize="10" VerticalAlignment="Center"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/PandoraOverlay;component/Assets/app.ico" Width="26" Height="26" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Foreground="#ECF2F8" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderCheck" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7CC884"
                               Margin="8,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="VersionText" Foreground="#ECF2F8" FontSize="20" FontWeight="Bold" Margin="0,14,0,0"/>
            <TextBlock x:Name="SubText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>

            <StackPanel x:Name="NotesArea" Margin="0,18,0,0">
                <TextBlock Text="WHAT'S NEW" Foreground="#9AA7B0" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="#1B222A" BorderBrush="#333C46" BorderThickness="1" CornerRadius="4" Padding="12,10,6,10">
                    <ScrollViewer x:Name="NotesScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NotesList" Margin="0,0,8,0"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Footer: a hint and the buttons, or the download progress. -->
            <Grid Margin="0,16,0,0">
                <DockPanel x:Name="ButtonRow">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LaterButton" Content="Later" Click="Close_Click" Style="{StaticResource NeutralButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="PrimaryButton" Click="Primary_Click" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="HintText" Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
                <StackPanel x:Name="ProgressRow" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" Foreground="#C7D1DA" FontSize="12"/>
                    <Grid Height="8" Margin="0,8,0,0">
                        <Border Background="#262D35" CornerRadius="4"/>
                        <Border x:Name="ProgressFill" Background="#7CC884" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock Text="The overlay closes and comes back in a few seconds." Foreground="#7B8790" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
