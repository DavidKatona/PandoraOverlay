<Window x:Class="PandoraOverlay.UpdateCardWindow"
        xmlns:local="clr-namespace:PandoraOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora Overlay update"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource Theme.Font.Family}">

    <!-- The update card (1.32): the Settings dialog's frame and buttons. Its
         templates are the app's (Themes/Controls.xaml) and every colour,
         corner and font a theme token, since 1.39; each dialog kept its own
         copies until then. Fixed size, the owner's call: the notes box
         scrolls instead of the card growing. The frame is the theme's
         (ThemedBorder: Default's rounded Border, or a theme's widget-sized
         cut). The card is never up while a theme is clicked, so what its
         code paints is read when it is built. -->
    <local:ThemedBorder CornerRadius="{DynamicResource Theme.Corner.Dialog}" CutCorners="{DynamicResource Theme.Cut.Widget}"
                        Background="{DynamicResource Theme.Glass.Dialog}" BorderThickness="1" Padding="16,14">
        <StackPanel>
            <!-- Header: icon, what this card is, ✕ (= Later). Draggable. -->
            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="&#x2715;" Click="Close_Click"
                        Style="{StaticResource DangerButtonStyle}" Width="22" Height="22" Padding="0" FontSize="10" VerticalAlignment="Center"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/PandoraOverlay;component/Assets/app.ico" Width="26" Height="26" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Foreground="{DynamicResource Theme.Text.Title}" FontSize="14" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Theme.Font.TitleFamily}" FontWeight="{DynamicResource Theme.Font.TitleWeight}"/>
                    <TextBlock x:Name="HeaderCheck" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Theme.UpdateCard.Good}"
                               Margin="8,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Theme.Text.Bright}" FontSize="20" FontWeight="Bold" Margin="0,14,0,0"/>
            <TextBlock x:Name="SubText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>

            <StackPanel x:Name="NotesArea" Margin="0,18,0,0">
                <TextBlock Text="WHAT'S NEW" Foreground="{DynamicResource Theme.Text.PageTitle}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource Theme.InfoCard.Surface}" BorderBrush="{DynamicResource Theme.InfoCard.Line}" BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.Corner.Card}" Padding="12,10,6,10">
                    <ScrollViewer x:Name="NotesScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NotesList" Margin="0,0,8,0"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Footer: a hint and the buttons, or the download progress. -->
            <Grid Margin="0,16,0,0">
                <DockPanel x:Name="ButtonRow">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LaterButton" Content="Later" Click="Close_Click" Style="{StaticResource NeutralButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="PrimaryButton" Click="Primary_Click" Style="{StaticResource SaveButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="HintText" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
                <StackPanel x:Name="ProgressRow" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Theme.Text.Text}" FontSize="12"/>
                    <Grid Height="8" Margin="0,8,0,0">
                        <Border Background="{DynamicResource Theme.UpdateCard.ProgressTrack}" CornerRadius="{DynamicResource Theme.Corner.Progress}"/>
                        <Border x:Name="ProgressFill" Background="{DynamicResource Theme.UpdateCard.Progress}" CornerRadius="{DynamicResource Theme.Corner.Progress}" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock Text="The overlay closes and comes back in a few seconds." Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </local:ThemedBorder>
</Window>
