<local:OverlayWindowBase x:Class="PandoraOverlay.PackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Pack"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource Theme.Font.Family}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- One of the two widget frames (WidgetFrame), the player's choice
         (PackFrame): its height is set in code from PackRows.FrameHeight, the
         content laid out INSIDE it, so the rows never grow the widget. The
         glass is ApplyAppearance's, the outline's colour ThemedBorder's (Lit
         in edit mode); a theme's cut corners take the theme's number. -->
    <local:ThemedBorder x:Name="RootPanel"
            Width="{x:Static local:WidgetFrame.Width}"
            Height="{x:Static local:WidgetFrame.SmallHeight}"
            CornerRadius="{DynamicResource Theme.Corner.Widget}"
            CutCorners="{DynamicResource Theme.Cut.Widget}"
            BorderThickness="1"
            Padding="12,10">
        <DockPanel>

            <!-- Header: the title + "3 of 5 in game", at the frame contract's
                 fixed height and gap (FrameContract.PackHeaderHeight, the 7 under
                 it its PackHeaderGap): the rows' room is computed from them. -->
            <DockPanel DockPanel.Dock="Top" Height="{x:Static local:FrameContract.PackHeaderHeight}" Margin="0,0,0,7">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Text.Label}" FontSize="{DynamicResource Theme.Size.12}" FontWeight="{DynamicResource Theme.Font.BodyWeight}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Pack" VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Text.Title}" FontSize="14"
                           FontFamily="{DynamicResource Theme.Font.TitleFamily}" FontWeight="{DynamicResource Theme.Font.TitleWeight}"/>
            </DockPanel>

            <!-- The rows, built in code at the code's heights (PackRows), from
                 the top; the body's line when there are none. Clipped: a theme's
                 taller font can never push a row out of the frame. -->
            <Grid ClipToBounds="True">
                <StackPanel x:Name="Rows" VerticalAlignment="Top"/>
                <TextBlock x:Name="EmptyText" VerticalAlignment="Top" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="{DynamicResource Theme.Size.12}" FontWeight="{DynamicResource Theme.Font.BodyWeight}"
                           Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </local:ThemedBorder>
</local:OverlayWindowBase>
