<!-- Camp (H27, box for box, in the page's own space: the page is the
     view's 0, 34, 798 x 476, so every y of the plan is 34 less here): the 21
     species' cards at the left (made in code, CampPage.xaml.cs), the chosen
     species at the right. Every colour, corner, size and font is the theme's
     by DynamicResource (A25); every word comes from HatchlingText by x:Static
     or from code (A24); nothing here opens a surface of its own or takes the
     keyboard (A33, A42). Camp is shown only while no run exists (H20), so it
     never has a run to tell of. -->
<Grid x:Class="PandoraOverlay.Games.Hatchling.CampPage"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:PandoraOverlay.Games.Hatchling"
      Width="798" Height="476" Background="Transparent"
      TextElement.FontFamily="{DynamicResource Theme.Font.Family}">

    <!-- The species, 12, 46, 522 x 442: three columns and seven rows of
         170 x 58, 6 apart, in the table's order row by row. -->
    <Grid x:Name="Cards" Margin="12,12,0,0" Width="522" Height="442"
          HorizontalAlignment="Left" VerticalAlignment="Top"/>

    <!-- The chosen species, 544, 46, 242 x 452, top to bottom: the header
         (56), 8, the four numbers (68), 6, the perk (16 + 30), the build's
         line (30), 6, on the server (50), 6, the danger (44), what is left with
         the note at its foot (51 + 45), the button (36). -->
    <Grid x:Name="Panel" Margin="544,12,0,0" Width="242" Height="452"
          HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="68"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- The header: the portrait in its well, the name, the stars, the kind. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Well" Grid.Column="0" Width="76" Height="56" BorderThickness="1"
                    Background="{DynamicResource Theme.Well.Surface}"
                    BorderBrush="{DynamicResource Theme.Well.Line}"
                    CornerRadius="{DynamicResource Theme.Corner.Well}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="ChosenName" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource Theme.Font.TitleFamily}" FontSize="14"
                           Foreground="{DynamicResource Theme.Text.Title}"/>
                <TextBlock x:Name="ChosenStars" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Theme.Text.Highlight}"
                           FontSize="{DynamicResource Theme.Size.12}"/>
                <TextBlock x:Name="ChosenKind" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Theme.Text.Dim}"
                           FontSize="{DynamicResource Theme.Size.11}"/>
            </StackPanel>
        </Grid>

        <!-- Four rows of 17: the numbers at 75% growth, with the lineage and the
             stars as they are now and no instinct. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="17"/>
                <RowDefinition Height="17"/>
                <RowDefinition Height="17"/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{x:Static h:HatchlingText.RowHealth}"
                       Foreground="{DynamicResource Theme.Text.Text2}" FontSize="{DynamicResource Theme.Size.11}"/>
            <TextBlock Grid.Row="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{x:Static h:HatchlingText.RowAttack}"
                       Foreground="{DynamicResource Theme.Text.Text2}" FontSize="{DynamicResource Theme.Size.11}"/>
            <TextBlock Grid.Row="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{x:Static h:HatchlingText.RowDefense}"
                       Foreground="{DynamicResource Theme.Text.Text2}" FontSize="{DynamicResource Theme.Size.11}"/>
            <TextBlock Grid.Row="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{x:Static h:HatchlingText.RowSight}"
                       Foreground="{DynamicResource Theme.Text.Text2}" FontSize="{DynamicResource Theme.Size.11}"/>
            <TextBlock x:Name="HealthValue" Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.Text.Bright}" FontSize="{DynamicResource Theme.Size.11}"/>
            <TextBlock x:Name="AttackValue" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.Text.Bright}" FontSize="{DynamicResource Theme.Size.11}"/>
            <TextBlock x:Name="DefenseValue" Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.Text.Bright}" FontSize="{DynamicResource Theme.Size.11}"/>
            <TextBlock x:Name="SightValue" Grid.Row="3" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.Text.Bright}" FontSize="{DynamicResource Theme.Size.11}"/>
        </Grid>

        <!-- The perk: its name, then its rule (room for two lines). -->
        <TextBlock x:Name="PerkName" Grid.Row="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Theme.Text.Bright}"
                   FontSize="{DynamicResource Theme.Size.12}"
                   FontWeight="{DynamicResource Theme.Font.ValueWeight}"/>
        <TextBlock x:Name="PerkText" Grid.Row="5" MaxHeight="30" VerticalAlignment="Top"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Theme.Text.Text}"
                   FontSize="{DynamicResource Theme.Size.11}"/>

        <!-- The build's line (room for two lines). -->
        <TextBlock x:Name="BuildLine" Grid.Row="6" MaxHeight="30" VerticalAlignment="Top"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Theme.Text.Dim}"
                   FontSize="{DynamicResource Theme.Size.11}"/>

        <!-- On the server: what growing this species there has given, and what it pays now (H18: a multiplier, never a wait). -->
        <Border Grid.Row="8" Padding="10,2" BorderThickness="1"
                Background="{DynamicResource Theme.InfoCard.Surface}"
                BorderBrush="{DynamicResource Theme.InfoCard.Line}"
                CornerRadius="{DynamicResource Theme.Corner.Card}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Margin="0" TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource SectionCaption}"
                           Text="{x:Static h:HatchlingText.ServerCaption}"/>
                <TextBlock x:Name="ServerGrown" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Theme.Text.Text}"
                           FontSize="{DynamicResource Theme.Size.11}"/>
                <TextBlock x:Name="ServerPays" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource Theme.Size.11}"/>
            </StackPanel>
        </Border>

        <!-- The danger: the caption, five radios (made in code), the line. -->
        <StackPanel Grid.Row="10">
            <TextBlock Margin="0" TextTrimming="CharacterEllipsis"
                       Style="{DynamicResource SectionCaption}"
                       Text="{x:Static h:HatchlingText.DangerCaption}"/>
            <StackPanel x:Name="DangerRadios" Orientation="Horizontal"/>
            <TextBlock x:Name="DangerLine" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.Text.Dim}"
                       FontSize="{DynamicResource Theme.Size.11}"/>
        </StackPanel>

        <!-- The note, at the foot of what is left (room for three lines, and the
             rest above it for a font that wraps one line more). -->
        <TextBlock x:Name="Note" Grid.Row="11" MaxHeight="60" VerticalAlignment="Bottom" Margin="0,0,0,6"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Theme.Text.Dim}"
                   FontSize="{DynamicResource Theme.Size.11}"/>

        <!-- Start a run, or the unlock (armed: the first click changes its words
             and its look, the second unlocks). -->
        <Button x:Name="ActionButton" Grid.Row="12" Focusable="False" Height="36"
                Style="{DynamicResource SaveButtonStyle}"/>
    </Grid>
</Grid>
