<UserControl x:Class="PandoraOverlay.MapCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PandoraOverlay">
    <!-- The map drawing every map shares (the minimap and the big map):
         the island picture and the layers that move with it, then the
         markers and the arrows. It fills its host; the host clips it. -->
    <Grid>
        <!-- Canvas host: measures the image with infinite space, so an
             oversized (zoomed) map never gets layout-clipped (a grid slot
             would clip it BEFORE the pan transform). -->
        <Canvas x:Name="MapLayer" x:FieldModifier="private">
            <Image x:Name="MapImage" x:FieldModifier="private"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <!-- The site's pre-rendered heatmap: an opaque PNG (grayscale map +
                 blobs + caption baked in), blended at the same 55% the
                 live-map page uses. Sized and translated in lockstep with
                 MapImage. -->
            <Image x:Name="HeatmapImage" x:FieldModifier="private"
                   Stretch="Fill"
                   Opacity="0.55"
                   Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <!-- The zone layers (the map's Layers menu; never on the minimap):
                 where the game's migration zones, patrol zones and sanctuaries
                 can be, as vector shapes (ZoneAsset), a soft tint with an edge
                 of the same hue (MapBrushes; tinted in code). Under the area
                 borders and the names, so those stay readable; the largest
                 kind lowest, so a sanctuary is never buried. Mass migrations
                 have their own path for the dashed edge. Scaled and
                 translated with the map like the borders. -->
            <Path x:Name="ZoneMigrationPath" x:FieldModifier="private"
                  StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Path x:Name="ZoneMassPath" x:FieldModifier="private"
                  StrokeLineJoin="Round" StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Path x:Name="ZonePatrolPath" x:FieldModifier="private"
                  StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Path x:Name="ZoneSanctuaryPath" x:FieldModifier="private"
                  StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False"/>
            <!-- Optional area borders: a dark outline round every named area,
                 from the bundled area map, as vector lines (sharp at any
                 zoom). Scaled to the map in code, translated with it like the
                 heatmap, and above it. Dark navy at 70% on purpose, not light
                 lines and not the area colours (owner, Oct 2 2026); the why is
                 on MinimapWindow.UpdateAreaBorders. The navy is data, never a
                 theme's (MapBrushes.AreaBorders, set in code). -->
            <Path x:Name="AreaBordersPath" x:FieldModifier="private"
                  Opacity="0.7"
                  StrokeLineJoin="Round"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"/>
            <!-- Two highlights on that layer: the outline of YOUR area (soft
                 light), and the outline of the area under the cursor (the edit
                 orange); the theme's colours. -->
            <Path x:Name="AreaOwnPath" x:FieldModifier="private"
                  Stroke="{DynamicResource Theme.Map.OwnArea}"
                  Opacity="0.6"
                  StrokeLineJoin="Round"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"/>
            <Path x:Name="AreaHoverPath" x:FieldModifier="private"
                  Stroke="{DynamicResource Theme.Map.Hover}"
                  Opacity="0.9"
                  StrokeLineJoin="Round"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"/>
            <!-- Breadcrumb trail, in map-pixel space and panned with the map.
                 Three age bands, oldest faintest: one polyline can't fade
                 along its length. -->
            <!-- Solid on purpose: a dash pattern is anchored at the first
                 point, so it would crawl along the whole trail every time the
                 tail trims. -->
            <!-- A theme's casing under the trail (Theme.Map.You.TrailOutline,
                 PLAN.md question 26): the same three bands once more, under
                 all three, wider (CasingWidth). Collapsed and empty while the
                 colour is transparent (Default, Isle): then nothing is drawn. -->
            <Polyline x:Name="CasingOld" x:FieldModifier="private" Stroke="{DynamicResource Theme.Map.You.TrailOutline}"
                      StrokeLineJoin="Round" Opacity="0.3" Visibility="Collapsed"/>
            <Polyline x:Name="CasingMid" x:FieldModifier="private" Stroke="{DynamicResource Theme.Map.You.TrailOutline}"
                      StrokeLineJoin="Round" Opacity="0.55" Visibility="Collapsed"/>
            <Polyline x:Name="CasingNew" x:FieldModifier="private" Stroke="{DynamicResource Theme.Map.You.TrailOutline}"
                      StrokeLineJoin="Round" Opacity="0.85" Visibility="Collapsed"/>
            <Polyline x:Name="TrailOld" x:FieldModifier="private" Stroke="{DynamicResource Theme.Map.You.Trail}" StrokeThickness="2"
                      StrokeLineJoin="Round" Opacity="0.3"/>
            <Polyline x:Name="TrailMid" x:FieldModifier="private" Stroke="{DynamicResource Theme.Map.You.Trail}" StrokeThickness="2"
                      StrokeLineJoin="Round" Opacity="0.55"/>
            <Polyline x:Name="TrailNew" x:FieldModifier="private" Stroke="{DynamicResource Theme.Map.You.Trail}" StrokeThickness="2"
                      StrokeLineJoin="Round" Opacity="0.85"/>
        </Canvas>
        <Canvas>
            <!-- What stays still between zooms: the markers and the names. One
                 element, so the big map can cache it as one picture. -->
            <Canvas x:Name="StillMarks" x:FieldModifier="private">
                <!-- Library waypoints: dots in their colours, the tracked one a
                     ringed diamond. Shapes are created in code; the layer sits
                     under the arrows on purpose. -->
                <Canvas x:Name="MarkerLayer" x:FieldModifier="private"/>
                <!-- Names: area and waypoint labels (the map's Area and Waypoint names),
                     all drawn by this one element (NameLayer); empty on the
                     minimap. -->
                <local:NameLayer x:Name="LabelLayer" x:FieldModifier="private"/>
            </Canvas>
            <!-- In-game friends as smaller arrows in their colours, above the
                 waypoints and under your own arrow. -->
            <Canvas x:Name="FriendLayer" x:FieldModifier="private"/>
            <!-- Your arrow in the theme's colours, over its painted glow
                 (PaintedGlow: the arrow's own geometry and transform, set in
                 code; radius 0 in Default, so nothing at all). -->
            <local:PaintedGlow x:Name="PlayerGlow" x:FieldModifier="private"
                               Radius="{DynamicResource Theme.Glow.You}"
                               Color="{DynamicResource Theme.Map.You.Glow.Color}"
                               Visibility="Collapsed"/>
            <Path x:Name="PlayerArrow" x:FieldModifier="private"
                  Data="M 0,-8 L 6,7 L 0,3.5 L -6,7 Z"
                  Fill="{DynamicResource Theme.Map.You.Arrow}"
                  Stroke="{DynamicResource Theme.Map.You.Outline}"
                  StrokeThickness="1"
                  Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</UserControl>
