<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms interop solely for the tray NotifyIcon (no WPF equivalent). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PandoraOverlay</RootNamespace>
    <AssemblyName>PandoraOverlay</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.20.1</Version>
    <DebugType>embedded</DebugType>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects these as global usings, which makes Brush and
         Application ambiguous against WPF. TrayIcon.cs imports explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PandoraOverlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app project lives at the repo root, so its default globs would
         otherwise swallow the test project's sources. -->
    <Compile Remove="PandoraOverlay.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Isla Pandora island map (© islapandora.eu; the site's asset
         URL is content-hashed so a runtime fetch would break on redeploys). -->
    <Resource Include="Assets\map.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
