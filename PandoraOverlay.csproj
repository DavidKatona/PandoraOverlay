<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms interop solely for the tray NotifyIcon (no WPF equivalent). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PandoraOverlay</RootNamespace>
    <AssemblyName>PandoraOverlay</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.41.0</Version>
    <DebugType>embedded</DebugType>
    <ApplicationManifest></ApplicationManifest>
    <!-- Program.Main, not the generated App.Main: Velopack's start-up call has to come first (v1.30). -->
    <StartupObject>PandoraOverlay.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects these as global usings, which makes Brush and
         Application ambiguous against WPF. TrayIcon.cs imports explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PandoraOverlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app project lives at the repo root, so its default globs would
         otherwise swallow the test project's sources. -->
    <Compile Remove="PandoraOverlay.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- One-click updates (v1.30): the same version as the packer the release workflow installs. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- The in-app sign-in (v1.31): the website's Discord login in a private
         browser window (SignInWindow). Needs Microsoft's WebView2 Runtime on
         the PC — part of Windows 11, on nearly every Windows 10, and the
         installer fetches it where it is missing (release.yml). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Isla Pandora island map (© islapandora.eu; the site's asset
         URL is content-hashed so a runtime fetch would break on redeploys). -->
    <Resource Include="Assets\map.png" />
    <Resource Include="Assets\app.ico" />
    <!-- The server rules seed: a dated copy of islapandora.eu/rules (the
         site has no rules endpoint — its page bakes the text into its
         bundle). An embedded resource, not a WPF Resource, so the loader
         stays WPF-free and the tests can read the same file. -->
    <EmbeddedResource Include="Assets\rules.json" LogicalName="rules.json" />
    <!-- The map calibration seed: a dated copy of /api/map/calibration, so a
         fresh install draws the arrow before its first successful fetch. -->
    <EmbeddedResource Include="Assets\calibration.json" LogicalName="calibration.json" />
    <!-- The area map: one flat colour per named area (areas.png) and its
         legend (areas.json), generated by tools/area-map and meant to be
         corrected by painting. Read as data, never drawn; embedded for the
         same reason as the rules. -->
    <EmbeddedResource Include="Assets\areas.png" LogicalName="areas.png" />
    <EmbeddedResource Include="Assets\areas.json" LogicalName="areas.json" />
    <!-- The map's zone layers: where the game's migration zones, patrol
         zones and sanctuaries can be, converted from VulnonaMAP's data by
         tools/zones (a dated copy, never fetched). Embedded like the rules. -->
    <EmbeddedResource Include="Assets\zones.json" LogicalName="zones.json" />
    <!-- The CHANGELOG itself (1.32): the update card's "Updated" mode and the
         About page's What's new read the running version's section from it,
         so they need no request and work for every copy. -->
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <!-- The site's access header (1.35), scrambled: written by
         tools/overlay-access/make-access.ps1, NEVER committed (.gitignore), and
         embedded only when it exists. The release build makes it from a GitHub
         secret; a build without it runs, with the four guarded endpoints
         blocked. See Core/OverlayAccess.cs. -->
    <EmbeddedResource Include="Assets\overlay-access.bin" LogicalName="overlay-access.bin" Condition="Exists('Assets\overlay-access.bin')" />
    <!-- The themes (1.39): every theme but Default is a sparse override file
         here, found by its resource name (Theme.cs), so a new theme is a new
         file and nothing else. Embedded like the rules, so the tests read
         them without WPF. Default itself is code (Themes/DefaultTheme.cs). -->
    <EmbeddedResource Include="Assets\Themes\*.json" LogicalName="Themes/%(Filename)%(Extension)" />
    <!-- The bundled fonts (1.39): one folder per family, each with its own
         licence as shipped. The faces are WPF Resources, addressed by the
         ;component pack form (Theme.FontFamilyOf), never installed into
         Windows. Each licence is embedded (About can show it) AND copied
         beside the program, as the SIL Open Font Licence asks. -->
    <Resource Include="Assets\Fonts\**\*.ttf" />
    <EmbeddedResource Include="Assets\Fonts\**\OFL.txt" />
    <Content Include="Assets\Fonts\**\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
