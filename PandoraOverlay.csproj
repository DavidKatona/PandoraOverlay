<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PandoraOverlay</RootNamespace>
    <AssemblyName>PandoraOverlay</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <DebugType>embedded</DebugType>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Isla Pandora island map (© islapandora.eu; the site's asset
         URL is content-hashed so a runtime fetch would break on redeploys). -->
    <Resource Include="Assets\map.png" />
  </ItemGroup>

</Project>
