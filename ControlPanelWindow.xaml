<local:OverlayWindowBase x:Class="PandoraOverlay.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Control Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom template: the default chrome paints its own bright hover
             highlight over our light text. A faint white glow overlay keeps
             every button's own colour (incl. Lock/Exit) and readable text. -->
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#2A3038"/>
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="HoverGlow" Background="#2EFFFFFF" CornerRadius="2"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverGlow" Property="Background" Value="#4DFFFFFF"/>
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel"
            CornerRadius="10"
            Background="#CC10151B"
            BorderBrush="#FFC864"
            BorderThickness="1"
            Padding="10,8">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <!-- Feature controls -->
                <Button Content="Settings…" Click="Settings_Click"
                        Style="{StaticResource PanelButton}"/>
                <Button Content="Show/hide minimap" Click="Minimap_Click"
                        Style="{StaticResource PanelButton}"/>
                <Button Content="Map view" Click="MapView_Click"
                        Style="{StaticResource PanelButton}"/>

                <Border Width="1" Background="#33FFFFFF" Margin="6,3,12,3"/>

                <!-- Overlay-session controls -->
                <Button Content="Lock" Click="Lock_Click"
                        Style="{StaticResource PanelButton}"
                        Background="#2E5E38" Foreground="#DFF3E2"/>
                <Button Content="Exit" Click="Exit_Click"
                        Style="{StaticResource PanelButton}"
                        Background="#552B2B" Foreground="#FFDDDD"
                        Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Text="drag panels to move · right-click map = waypoint · Ctrl+F8 locks"
                       Foreground="#7B8790" FontSize="10" Margin="2,7,0,0"/>
        </StackPanel>
    </Border>
</local:OverlayWindowBase>
