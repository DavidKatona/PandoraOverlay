<local:OverlayWindowBase x:Class="PandoraOverlay.PrimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Prime Tracker"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- The LARGE frame (WidgetFrame), shared with the minimap: header on
         top, the two-line footer at the bottom, the ten condition rows
         share what is left — one size in every state. -->
    <Border x:Name="RootPanel"
            Width="{x:Static local:WidgetFrame.Width}"
            Height="{x:Static local:WidgetFrame.LargeHeight}"
            CornerRadius="10"
            Background="#CC10151B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12,10">
        <DockPanel>

            <!-- Header: title + overall status -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                           Foreground="#9AA7B0" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Prime"
                           Foreground="#ECF2F8" FontSize="14" FontWeight="Bold"/>
            </DockPanel>

            <!-- Footer: what the rows reflect, then cooldown / notices -->
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock x:Name="InfoText"
                           Foreground="#7B8790" FontSize="10" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NoticeText"
                           Foreground="#7B8790" FontSize="10" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Ten condition rows, built in code-behind into equal-height rows -->
            <Grid x:Name="ConditionRows"/>
        </DockPanel>
    </Border>
</local:OverlayWindowBase>
