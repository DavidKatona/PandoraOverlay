<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PandoraOverlay">
    <!-- The app's ONE set of control templates (1.39, PLAN.md section 1),
         merged in App.xaml's Application.Resources, and by
         Theme.EnsureLoaded for the harnesses, which build windows without
         the App. Every colour, corner and font size here is a theme token
         read by DynamicResource ({DynamicResource Theme.Button.Neutral.Idle.Fill}),
         and every shape a pick from the catalogue (ThemeShape), so no theme
         ever ships XAML. Step 2 brought the control panel's styles, step 4
         the maps' menu entries and ticks; step 5 brings the ones
         SettingsWindow.xaml, the update card and the
         sign-in window each hold their own copies of today. The slider gets
         two Styles then: WPF's own for a Stock thumb, and ThemedSlider for a
         drawn one; Theme.Apply puts the right one under Theme.SliderStyle. -->

    <!-- ===== The control panel (ControlPanelWindow.xaml) ===== -->

    <!-- Our own template: the default chrome paints its own bright hover
         highlight over our light text. A faint white glow overlay keeps
         every button's own colour (incl. Lock/Exit, which set their own
         family's fill, text and line) and readable text. The family's line
         is a 1 px outline drawn over the fill, never a border that would
         shrink it: transparent in Default, so nothing shows. The panel has a
         fixed frame (ControlPanelFrame, 1.39): every button its fixed width
         (set on the button) and height, the label centred in it and ending
         in an ellipsis if a font ever makes it too long, so a label never
         grows the panel. The padding is only how close the label may come
         to the button's edges before it trims. -->
    <Style x:Key="PanelButton" TargetType="Button">
        <Setter Property="Height" Value="{x:Static local:ControlPanelFrame.ButtonHeight}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.ControlPanelButtonSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Font.BodyWeight}"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Button.Neutral.Idle.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Button.Neutral.Idle.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Button.Neutral.Idle.Line}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Theme.Corner.Button}"/>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Theme.Corner.Button}"/>
                        <Border x:Name="HoverGlow" Background="{DynamicResource Theme.Button.HoverGlow}"
                                CornerRadius="{DynamicResource Theme.Corner.Button}" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverGlow" Property="Background" Value="{DynamicResource Theme.Button.PressedGlow}"/>
                            <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The caption over each widget's group of buttons (STATS, MINIMAP …),
         a fixed height in the panel's frame, trimmed rather than wider. -->
    <Style x:Key="PanelCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Caption}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Font.CaptionWeight}"/>
        <Setter Property="Height" Value="{x:Static local:ControlPanelFrame.CaptionHeight}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="1,0,0,3"/>
    </Style>

    <!-- The hairline between the groups. -->
    <Style x:Key="PanelSeparator" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Separator}"/>
        <Setter Property="Margin" Value="10,2,10,2"/>
    </Style>

    <!-- ===== The maps' menus (step 4; Minimap/MapMenuStyles.xaml until then) ===== -->

    <!-- A map menu's entry (MapMenuBuilder), the same on every map: the
         control panel's glow-overlay look, left-aligned, in the menu row's
         states (Theme.MenuRow). The menus' panels are plain Borders on the
         theme's menu glass and frame line, set where each map holds its popup. -->
    <Style x:Key="MenuButton" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Font.BodyWeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.MenuRow.Idle.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="HoverGlow" Background="{DynamicResource Theme.MenuRow.Hover.Fill}"
                                CornerRadius="{DynamicResource Theme.Corner.Button}" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverGlow" Property="Background" Value="{DynamicResource Theme.MenuRow.Pressed.Fill}"/>
                            <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.MenuRow.Disabled.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tick in a map menu (the map's Layers menu): the entry look with a
         ✓ column, the label lit while on (Theme.MenuRow.Ticked). It acts at
         once and leaves the menu open. Never focusable, so Space stays
         "centre on me". -->
    <Style x:Key="MenuTick" TargetType="ToggleButton">
        <Setter Property="Padding" Value="10,4,16,4"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Font.BodyWeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.MenuRow.Idle.Text}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Row" Background="{DynamicResource Theme.MenuRow.Idle.Fill}">
                        <Border x:Name="HoverGlow" Background="{DynamicResource Theme.MenuRow.Hover.Fill}"
                                CornerRadius="{DynamicResource Theme.Corner.Button}" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Tick" Text="✓" Width="18" Visibility="Hidden"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.MenuRow.Ticked.Fill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.MenuRow.Ticked.Text}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverGlow" Property="Background" Value="{DynamicResource Theme.MenuRow.Pressed.Fill}"/>
                            <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.MenuRow.Disabled.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
