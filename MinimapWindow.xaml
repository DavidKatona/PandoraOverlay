<local:OverlayWindowBase x:Class="PandoraOverlay.MinimapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Minimap"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        MouseWheel="Window_MouseWheel">

    <Border x:Name="RootPanel"
            CornerRadius="10"
            Background="#CC10151B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="6">
        <StackPanel>

            <!-- Edit-mode banner (hidden while locked / click-through) -->
            <DockPanel x:Name="EditBanner" Visibility="Collapsed" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right"
                        Content="&#x2715;"
                        Click="Hide_Click"
                        Width="22" Height="22" Padding="0"
                        Background="#552B2B" Foreground="#FFDDDD"
                        BorderThickness="0" FontSize="10"
                        ToolTip="Hide minimap (MAP on the stats panel brings it back)"/>
                <Button DockPanel.Dock="Right"
                        Content="VIEW"
                        Click="View_Click"
                        Width="38" Height="22" Padding="0" Margin="0,0,6,0"
                        Background="#2A3038" Foreground="#C7D1DA"
                        BorderThickness="0" FontSize="9" FontWeight="Bold"
                        ToolTip="Toggle whole-island / player-centered view (mouse wheel zooms the centered view)"/>
                <TextBlock Text="MINIMAP — drag to move · right-click sets a waypoint"
                           Foreground="#FFC864" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>

            <Grid x:Name="MapHost" Width="230" Height="230" ClipToBounds="True">
                <!-- Canvas host: measures the image with infinite space, so the
                     oversized centered-mode map never gets layout-clipped
                     (a grid slot would clip it BEFORE the pan transform). -->
                <Canvas>
                    <Image x:Name="MapImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Canvas>
                <Canvas>
                    <Path x:Name="WaypointMark"
                          Data="M 0,-7 L 7,0 L 0,7 L -7,0 Z"
                          Fill="#4FC3F7"
                          Stroke="#990A1520"
                          StrokeThickness="1.5"
                          Visibility="Collapsed"/>
                    <Path x:Name="PlayerArrow"
                          Data="M 0,-8 L 6,7 L 0,3.5 L -6,7 Z"
                          Fill="#FFC864"
                          Stroke="#991A130A"
                          StrokeThickness="1"
                          Visibility="Collapsed"/>
                </Canvas>
                <TextBlock x:Name="MapStatus"
                           Text="connecting…"
                           Foreground="#9AA7B0" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Mode footer: which view is active (and the zoom, in centered mode) -->
            <TextBlock x:Name="ModeFooter"
                       Foreground="#7B8790" FontSize="10" Margin="0,5,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</local:OverlayWindowBase>
