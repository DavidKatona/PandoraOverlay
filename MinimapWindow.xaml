<local:OverlayWindowBase x:Class="PandoraOverlay.MinimapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Minimap"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        MouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave"
        MouseWheel="Window_MouseWheel">

    <Window.Resources>
        <!-- Map menu entries: the control panel's glow-overlay look, left-aligned. -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverGlow" Background="#2EFFFFFF" CornerRadius="2"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverGlow" Property="Background" Value="#4DFFFFFF"/>
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5E6B76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel"
            CornerRadius="10"
            Background="#CC10151B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="6">
        <StackPanel>

            <Grid x:Name="MapHost" Width="230" Height="230" ClipToBounds="True">
                <!-- Canvas host: measures the image with infinite space, so the
                     oversized centered-mode map never gets layout-clipped
                     (a grid slot would clip it BEFORE the pan transform). -->
                <Canvas>
                    <Image x:Name="MapImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- The site's pre-rendered heatmap: an opaque PNG (grayscale
                         map + blobs + caption baked in), blended at the same 55%
                         the live-map page uses. Sized and translated in lockstep
                         with MapImage, so both views just work. -->
                    <Image x:Name="HeatmapImage"
                           Stretch="Fill"
                           Opacity="0.55"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- Breadcrumb trail, in map-pixel space and panned with the
                         map. Three age bands, oldest faintest: one polyline
                         can't fade along its length. -->
                    <Polyline x:Name="TrailOld" Stroke="#FFC864" StrokeThickness="2"
                              StrokeLineJoin="Round" Opacity="0.3"/>
                    <Polyline x:Name="TrailMid" Stroke="#FFC864" StrokeThickness="2"
                              StrokeLineJoin="Round" Opacity="0.55"/>
                    <Polyline x:Name="TrailNew" Stroke="#FFC864" StrokeThickness="2"
                              StrokeLineJoin="Round" Opacity="0.85"/>
                </Canvas>
                <Canvas>
                    <!-- Library waypoints: dots in their colours, the tracked one
                         a ringed diamond. Shapes are created in code from the
                         library; the layer sits under the arrow on purpose. -->
                    <Canvas x:Name="MarkerLayer"/>
                    <Path x:Name="PlayerArrow"
                          Data="M 0,-8 L 6,7 L 0,3.5 L -6,7 Z"
                          Fill="#FFC864"
                          Stroke="#991A130A"
                          StrokeThickness="1"
                          Visibility="Collapsed"/>
                </Canvas>
                <TextBlock x:Name="MapStatus"
                           Text="connecting…"
                           Foreground="#9AA7B0" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- Scale bar: bottom-left (the heatmap's baked caption owns the
                     top-left); the glass backing keeps it readable over any terrain. -->
                <Border x:Name="ScaleBarPanel"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                        Background="#9910151B" CornerRadius="4" Padding="5,1,5,4"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ScaleBarLabel" Foreground="#ECF2F8" FontSize="9"
                                   HorizontalAlignment="Center"/>
                        <Border x:Name="ScaleBarLine" Height="4" HorizontalAlignment="Center"
                                BorderBrush="#ECF2F8" BorderThickness="1.5,0,1.5,1.5"/>
                    </StackPanel>
                </Border>
                <!-- Heading + speed: bottom-right, the scale bar's twin. -->
                <Border x:Name="SpeedPanel"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                        Background="#9910151B" CornerRadius="4" Padding="5,2"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="SpeedText" Foreground="#ECF2F8" FontSize="9"/>
                </Border>
            </Grid>

            <!-- Footer: view (+ zoom when centered) · nearest waypoint distance and ETA; built in code. -->
            <TextBlock x:Name="ModeFooter"
                       Foreground="#7B8790" FontSize="10" Margin="0,5,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>

    <!-- Edit-mode right-click menu on the map. A popup is its own window, so
         the minimap's size never changes with it. Items are built in code. -->
    <local:OverlayWindowBase.Tag>
        <Popup x:Name="MapMenu" StaysOpen="False" AllowsTransparency="True"
               Placement="MousePoint" PopupAnimation="None">
            <Border x:Name="MapMenuPanel" Focusable="True" PreviewKeyDown="MapMenu_PreviewKeyDown"
                    Background="#F210151B" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="6" Padding="4" MinWidth="170">
                <StackPanel x:Name="MapMenuItems"/>
            </Border>
        </Popup>
    </local:OverlayWindowBase.Tag>
</local:OverlayWindowBase>
