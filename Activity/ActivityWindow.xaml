<local:OverlayWindowBase x:Class="PandoraOverlay.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Activity"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- The SMALL frame (WidgetFrame), shared with the stats panel: header on
         top, the feed's slots share what is left — one size in every state. -->
    <Border x:Name="RootPanel"
            Width="{x:Static local:WidgetFrame.Width}"
            Height="{x:Static local:WidgetFrame.SmallHeight}"
            CornerRadius="10"
            Background="#CC10151B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12,10">
        <DockPanel>

            <!-- Header: title + "3 of 7 friends in game" -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right"
                           Foreground="#9AA7B0" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Activity"
                           Foreground="#ECF2F8" FontSize="14" FontWeight="Bold"/>
            </DockPanel>

            <!-- Feed lines, newest at the top; built in code-behind into equal-height rows -->
            <Grid x:Name="Lines"/>
        </DockPanel>
    </Border>
</local:OverlayWindowBase>
