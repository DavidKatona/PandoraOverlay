<local:OverlayWindowBase x:Class="PandoraOverlay.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Activity"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource Theme.Font.Family}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- The SMALL frame (WidgetFrame), shared with the stats panel: header on
         top, the feed's slots share what is left — one size in every state.
         The glass is ApplyAppearance's, the outline's colour ThemedBorder's
         (Lit in edit mode); a theme's cut corners take the theme's number. -->
    <local:ThemedBorder x:Name="RootPanel"
            Width="{x:Static local:WidgetFrame.Width}"
            Height="{x:Static local:WidgetFrame.SmallHeight}"
            CornerRadius="{DynamicResource Theme.Corner.Widget}"
            CutCorners="{DynamicResource Theme.Cut.Widget}"
            BorderThickness="1"
            Padding="12,10">
        <DockPanel>

            <!-- Header: title + "3 of 7 friends in game" -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Activity.Count}" FontSize="12" FontWeight="{DynamicResource Theme.Font.BodyWeight}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Activity"
                           Foreground="{DynamicResource Theme.Text.Title}" FontSize="14"
                           FontFamily="{DynamicResource Theme.Font.TitleFamily}" FontWeight="{DynamicResource Theme.Font.TitleWeight}"/>
            </DockPanel>

            <!-- Feed lines, newest at the top; built in code-behind into
                 equal-height rows, with the list rule and its gap in the two
                 columns left of the lines (both 0 wide in Default, so nothing
                 in the layout; a theme's rule narrows the lines, never the
                 frame). The rule spans the rows that hold a line, so it ends
                 at the last one (Render). -->
            <Grid x:Name="Lines">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
            </Grid>
        </DockPanel>
    </local:ThemedBorder>
</local:OverlayWindowBase>
