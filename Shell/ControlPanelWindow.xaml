<local:OverlayWindowBase x:Class="PandoraOverlay.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Control Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom template: the default chrome paints its own bright hover
             highlight over our light text. A faint white glow overlay keeps
             every button's own colour (incl. Lock/Exit) and readable text. -->
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#2A3038"/>
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="HoverGlow" Background="#2EFFFFFF" CornerRadius="2"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverGlow" Property="Background" Value="#4DFFFFFF"/>
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7B8790"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1,0,0,3"/>
        </Style>

        <Style x:Key="GroupSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Margin" Value="10,2,10,2"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel"
            CornerRadius="10"
            Background="#CC10151B"
            BorderBrush="#FFC864"
            BorderThickness="1"
            Padding="10,8">
        <StackPanel>
            <!-- One row, grouped by widget: a caption over each widget's own
                 controls, so labels stay short and a new widget adds a group
                 instead of more loose buttons. -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Settings…" Click="Settings_Click"
                        Style="{StaticResource PanelButton}"
                        VerticalAlignment="Bottom" Margin="0"/>

                <Border Style="{StaticResource GroupSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource GroupCaption}" Text="STATS"/>
                    <Button Content="Show/hide" Click="Stats_Click"
                            Style="{StaticResource PanelButton}" Margin="0"/>
                </StackPanel>

                <Border Style="{StaticResource GroupSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource GroupCaption}" Text="MINIMAP"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Minimap_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Map view" Click="MapView_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Heatmap" Click="Heatmap_Click"
                                Style="{StaticResource PanelButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource GroupSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource GroupCaption}" Text="PRIME"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Prime_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Check" Click="CheckPrime_Click"
                                Style="{StaticResource PanelButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource GroupSeparator}"/>

                <!-- Overlay-session controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Lock" Click="Lock_Click"
                            Style="{StaticResource PanelButton}"
                            Background="#2E5E38" Foreground="#DFF3E2"/>
                    <Button Content="Exit" Click="Exit_Click"
                            Style="{StaticResource PanelButton}"
                            Background="#552B2B" Foreground="#FFDDDD"
                            Margin="0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Text="drag panels to move · right-click map = waypoint · Ctrl+F7 locks"
                       Foreground="#7B8790" FontSize="10" Margin="2,7,0,0"/>
        </StackPanel>
    </Border>
</local:OverlayWindowBase>
