<local:OverlayWindowBase x:Class="PandoraOverlay.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Control Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource Theme.Font.Family}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Its buttons, captions and separators are the app's shared styles
         (Themes/Controls.xaml: PanelButton, PanelCaption, PanelSeparator).
         The frame is the control panel's own (Kind), Lit for good: it only
         exists in edit mode. The glass is ApplyAppearance's (the theme's
         widget glass at the Background opacity slider) and the outline's
         colour ThemedBorder's; a theme's glow is painted inside the outline,
         within the padding, so the panel keeps its size. -->
    <local:ThemedBorder x:Name="RootPanel"
            Kind="ControlPanel"
            Lit="True"
            CornerRadius="{DynamicResource Theme.Corner.Widget}"
            BorderThickness="1"
            Padding="10,8">
        <StackPanel>
            <!-- One row, grouped by widget: a caption over each widget's own
                 controls, so labels stay short and a new widget adds a group
                 instead of more loose buttons. -->
            <!-- ONE row is the owner's call (Sep 2026): a two-row layout was
                 tried and rejected. -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Settings…" Click="Settings_Click"
                        Style="{StaticResource PanelButton}"
                        VerticalAlignment="Bottom" Margin="0"/>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="STATS"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Stats_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="View" Click="StatsView_Click"
                                Style="{StaticResource PanelButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="MINIMAP"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Minimap_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Map view" Click="MapView_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Heatmap" Click="Heatmap_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Areas" Click="AreaBorders_Click"
                                Style="{StaticResource PanelButton}" Margin="0"
                                ToolTip="Show or hide the borders between the island's named areas"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="PRIME"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Prime_Click"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Check" Click="CheckPrime_Click"
                                Style="{StaticResource PanelButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="ACTIVITY"/>
                    <Button Content="Show/hide" Click="Activity_Click"
                            Style="{StaticResource PanelButton}" Margin="0"/>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <!-- Overlay-session controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Lock" Click="Lock_Click"
                            Style="{StaticResource PanelButton}"
                            Background="{DynamicResource Theme.Button.Primary.Idle.Fill}" Foreground="{DynamicResource Theme.Button.Primary.Idle.Text}"/>
                    <Button Content="Exit" Click="Exit_Click"
                            Style="{StaticResource PanelButton}"
                            Background="{DynamicResource Theme.Button.Danger.Idle.Fill}" Foreground="{DynamicResource Theme.Button.Danger.Idle.Text}"
                            Margin="0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Text="drag panels to move · right-click map = waypoint · Ctrl+F1 locks"
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" Margin="2,7,0,0"/>
        </StackPanel>
    </local:ThemedBorder>
</local:OverlayWindowBase>
