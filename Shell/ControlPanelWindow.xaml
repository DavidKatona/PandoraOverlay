<local:OverlayWindowBase x:Class="PandoraOverlay.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Control Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource Theme.Font.Family}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Its buttons, captions and separators are the app's shared styles
         (Themes/Controls.xaml: PanelButton, PanelCaption, PanelSeparator).
         The frame is the control panel's own (Kind), Lit for good: it only
         exists in edit mode. The glass is ApplyAppearance's (the theme's
         widget glass at the Background opacity slider) and the outline's
         colour ThemedBorder's; a theme's glow is painted inside the outline,
         within the padding. Its size is fixed (ControlPanelFrame, 1.39, the
         owner's call: Isle's compact panel, for every theme): the root, each
         button's width and height, the caption and hint rows; a label is
         centred and trimmed inside its part, so no font grows the panel. -->
    <local:ThemedBorder x:Name="RootPanel"
            Kind="ControlPanel"
            Lit="True"
            Width="{x:Static local:ControlPanelFrame.Width}"
            Height="{x:Static local:ControlPanelFrame.Height}"
            CornerRadius="{DynamicResource Theme.Corner.Widget}"
            BorderThickness="1"
            Padding="10,8">
        <StackPanel>
            <!-- One row, grouped by widget: a caption over each widget's own
                 controls, so labels stay short and a new widget adds a group
                 instead of more loose buttons. -->
            <!-- ONE row is the owner's call (Sep 2026): a two-row layout was
                 tried and rejected. -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Settings…" Click="Settings_Click" Width="{x:Static local:ControlPanelFrame.SettingsButton}"
                        Style="{StaticResource PanelButton}"
                        VerticalAlignment="Bottom" Margin="0"/>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="STATS"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Stats_Click" Width="{x:Static local:ControlPanelFrame.ShowHideButton}"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="View" Click="StatsView_Click" Width="{x:Static local:ControlPanelFrame.ViewButton}"
                                Style="{StaticResource PanelButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="MINIMAP"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Minimap_Click" Width="{x:Static local:ControlPanelFrame.ShowHideButton}"
                                Style="{StaticResource PanelButton}"/>
                        <!-- The minimap's view and its two layers behind one menu
                             (the Pack, Nov 2026: Map view, Heatmap and Areas gave
                             way to it), as the map's own Layers button: lit while
                             open, its menu above it, filled in code
                             (ControlPanelWindow.Layers.cs). The popup sits ALONE in
                             the button's Tag, out of the window's tree, as the
                             map's does: keys pressed in it never reach the
                             window's own Esc, which locks edit mode, and a popup
                             held in a Tag inside a Grid never opens. -->
                        <ToggleButton x:Name="LayersButton" Content="Layers" Click="LayersButton_Click"
                                      Width="{x:Static local:ControlPanelFrame.LayersButton}"
                                      Style="{StaticResource PanelToggle}" Margin="0"
                                      ToolTip="The minimap's view, its heatmap and its area borders">
                            <ToggleButton.Tag>
                                <Popup x:Name="LayersMenu" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Custom" PopupAnimation="None"
                                       Opened="LayersMenu_Opened" Closed="LayersMenu_Closed">
                                    <Border x:Name="LayersMenuPanel" Focusable="True"
                                            PreviewKeyDown="LayersMenu_PreviewKeyDown" PreviewKeyUp="LayersMenu_PreviewKeyUp"
                                            TextElement.FontFamily="{DynamicResource Theme.Font.Family}"
                                            Background="{DynamicResource Theme.Glass.Menu}" BorderBrush="{DynamicResource Theme.Frame.Locked.Line}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Theme.Corner.Menu}" Padding="4"
                                            Width="{x:Static local:ControlPanelFrame.LayersMenuWidth}">
                                        <StackPanel x:Name="LayersItems"/>
                                    </Border>
                                </Popup>
                            </ToggleButton.Tag>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="PRIME"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Show/hide" Click="Prime_Click" Width="{x:Static local:ControlPanelFrame.ShowHideButton}"
                                Style="{StaticResource PanelButton}"/>
                        <Button Content="Check" Click="CheckPrime_Click" Width="{x:Static local:ControlPanelFrame.CheckButton}"
                                Style="{StaticResource PanelButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="ACTIVITY"/>
                    <Button Content="Show/hide" Click="Activity_Click" Width="{x:Static local:ControlPanelFrame.ShowHideButton}"
                            Style="{StaticResource PanelButton}" Margin="0"/>
                </StackPanel>

                <Border Style="{StaticResource PanelSeparator}"/>

                <!-- The Pack (Nov 2026): greyed while it has nobody to show (its ticked
                     mode with none ticked: there is no window then), its tooltip saying what to change. -->
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="PACK"/>
                    <Button x:Name="PackButton" Content="Show/hide" Click="Pack_Click" Width="{x:Static local:ControlPanelFrame.ShowHideButton}"
                            Style="{StaticResource PanelButton}" Margin="0" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>

                <!-- What the Layers menu freed beyond the Pack's group: Lock and Exit at the right end. -->
                <Border Width="{x:Static local:ControlPanelFrame.SessionGap}"/>

                <Border Style="{StaticResource PanelSeparator}"/>

                <!-- Overlay-session controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Lock" Click="Lock_Click" Width="{x:Static local:ControlPanelFrame.LockButton}"
                            Style="{StaticResource PanelButton}"
                            Background="{DynamicResource Theme.Button.Primary.Idle.Fill}" Foreground="{DynamicResource Theme.Button.Primary.Idle.Text}"
                            BorderBrush="{DynamicResource Theme.Button.Primary.Idle.Line}"/>
                    <Button Content="Exit" Click="Exit_Click" Width="{x:Static local:ControlPanelFrame.ExitButton}"
                            Style="{StaticResource PanelButton}"
                            Background="{DynamicResource Theme.Button.Danger.Idle.Fill}" Foreground="{DynamicResource Theme.Button.Danger.Idle.Text}"
                            BorderBrush="{DynamicResource Theme.Button.Danger.Idle.Line}"
                            Margin="0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Text="drag panels to move · right-click map = waypoint · Ctrl+F1 locks"
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="{DynamicResource Theme.Size.10}" FontWeight="{DynamicResource Theme.Font.BodyWeight}" Margin="2,5,0,0"
                       Height="{x:Static local:ControlPanelFrame.HintHeight}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </local:ThemedBorder>
</local:OverlayWindowBase>
