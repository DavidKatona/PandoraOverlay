<local:OverlayWindowBase x:Class="PandoraOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- The SMALL frame (WidgetFrame): a fixed outer size the content lays out
         inside, shared with the Activity feed. The status line docks to the
         bottom, so any slack sits between the bars and the status. Two views
         share the frame (StatsView): Survival with health, stamina, hunger
         and thirst, and Combat with health, stamina, damage and speed. -->
    <Border x:Name="RootPanel"
            Width="{x:Static local:WidgetFrame.Width}"
            Height="{x:Static local:WidgetFrame.SmallHeight}"
            CornerRadius="10"
            Background="#CC10151B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12,10">
        <DockPanel>

            <!-- Header: dino + growth (the growth readout is hidden in the combat view) -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="GrowthText" DockPanel.Dock="Right"
                           Foreground="#9AA7B0" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="DinoText" Text="Connecting…"
                           Foreground="#ECF2F8" FontSize="14" FontWeight="Bold"/>
            </DockPanel>

            <!-- Status line -->
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                       Foreground="#7B8790" FontSize="10" Margin="0,8,0,0"/>

            <!-- Fracture badges: ALWAYS present (dim when intact, lit when
                 fractured), so a fracture can never resize the panel. -->
            <StackPanel x:Name="FractureRow" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,7,0,0">
                <Border x:Name="FracHead" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock x:Name="FracHeadText" Text="HEAD" FontSize="10" FontWeight="Bold"/>
                </Border>
                <Border x:Name="FracBody" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock x:Name="FracBodyText" Text="BODY" FontSize="10" FontWeight="Bold"/>
                </Border>
                <Border x:Name="FracLegs" CornerRadius="4" Padding="6,2">
                    <TextBlock x:Name="FracLegsText" Text="LEGS" FontSize="10" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- The bars fill what is left: one of the two views is visible. -->
            <Grid>

            <!-- ===== Survival view: health, stamina, hunger, thirst ===== -->
            <StackPanel x:Name="FullView" VerticalAlignment="Top">

            <!-- Health -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Health" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#3D202830" VerticalAlignment="Center">
                    <Border x:Name="HealthFill" Height="12" CornerRadius="6" Background="#4CAF50"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="HealthPct" Grid.Column="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Stamina -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stamina" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#3D202830" VerticalAlignment="Center">
                    <Border x:Name="StaminaFill" Height="12" CornerRadius="6" Background="#FFD54F"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <!-- Time until empty while draining, "full ~40s" while recovering (StaminaTracker). -->
                <TextBlock x:Name="StaminaLeft" Grid.Column="1" FontSize="10"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="StaminaPct" Grid.Column="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Hunger -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hunger" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#3D202830" VerticalAlignment="Center">
                    <Border x:Name="HungerFill" Height="12" CornerRadius="6" Background="#FF9800"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <!-- Time left at the current drain rate: a data label riding the fill's tip
                     (positioned and coloured in code). Over the track, not in it, so the
                     12 px bar height can't clip the text. -->
                <TextBlock x:Name="HungerLeft" Grid.Column="1" FontSize="10"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="HungerPct" Grid.Column="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Thirst -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Thirst" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#3D202830" VerticalAlignment="Center">
                    <Border x:Name="ThirstFill" Height="12" CornerRadius="6" Background="#4FC3F7"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="ThirstLeft" Grid.Column="1" FontSize="10"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="ThirstPct" Grid.Column="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            </StackPanel>

            <!-- ===== Combat view: the same four rows, different information =====
                 Health and stamina as in the survival view, then what matters in
                 a fight in place of hunger and thirst: damage taken in this fight
                 (a red bar that GROWS) and your speed (a number — there is no
                 honest full mark for a speed bar). Same sizes and positions as
                 the survival view, so flipping moves nothing. -->
            <StackPanel x:Name="CombatView" VerticalAlignment="Top" Visibility="Collapsed">

            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Health" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#3D202830" VerticalAlignment="Center">
                    <Border x:Name="CombatHealthFill" Height="12" CornerRadius="6" Background="#4CAF50"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="CombatHealthPct" Grid.Column="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stamina" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#3D202830" VerticalAlignment="Center">
                    <Border x:Name="CombatStaminaFill" Height="12" CornerRadius="6" Background="#FFD54F"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="CombatStaminaLeft" Grid.Column="1" FontSize="10"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="CombatStaminaPct" Grid.Column="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Damage taken in this fight: fills as you lose health, clears 30 s after the last hit -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Damage" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#3D202830" VerticalAlignment="Center">
                    <Border x:Name="DamageFill" Height="12" CornerRadius="6" Background="#E53935"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="DamagePct" Grid.Column="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Speed: a number, no bar (its top value changes with growth, so no scale would be true) -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speed" Foreground="#C7D1DA" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="SpeedValue" Grid.Column="1" Grid.ColumnSpan="2" Foreground="#C7D1DA" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            </StackPanel>

            </Grid>
        </DockPanel>
    </Border>
</local:OverlayWindowBase>
