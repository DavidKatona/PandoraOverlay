<local:OverlayWindowBase x:Class="PandoraOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="Pandora Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource Theme.Font.Family}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- The SMALL frame (WidgetFrame): a fixed outer size the content lays out
         inside, shared with the Activity feed. The status line docks to the
         bottom, so any slack sits between the bars and the status. Two views
         share the frame (StatsView): Survival with health, stamina, hunger
         and thirst, and Combat with health, stamina, damage and speed. The
         glass is ApplyAppearance's, the outline's colour ThemedBorder's (Lit
         in edit mode); a theme's cut corners take the theme's number. The
         colours that follow a stat (the fills, the percents, the time
         labels, the header's corner, the badges) are painted in code from
         the bars' states (MainWindow.Stats.cs, PaintStats); what is set here
         is the look before the first paint. -->
    <local:ThemedBorder x:Name="RootPanel"
            Width="{x:Static local:WidgetFrame.Width}"
            Height="{x:Static local:WidgetFrame.SmallHeight}"
            CornerRadius="{DynamicResource Theme.Corner.Widget}"
            CutCorners="{DynamicResource Theme.Cut.Widget}"
            BorderThickness="1"
            Padding="12,10">
        <DockPanel>

            <!-- Header: dino + the view's own readout in the corner — growth in the
                 survival view, the game's Wounded state (health under 50%) in
                 the combat view. One of the two is visible. A theme's title
                 glyph sits before the name; Default has none, and None takes
                 no room at all. Where a theme's font leaves the name too
                 little room, it ends in an ellipsis (the owner, Oct 25 2026:
                 never another wording per theme); in Default it fits. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="GrowthText" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Growth.Growing}" FontSize="{DynamicResource Theme.Size.12}" FontWeight="{DynamicResource Theme.Font.BodyWeight}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ConditionText" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Bars.HealthReadout.Above75}" FontSize="{DynamicResource Theme.Size.12}" FontWeight="{DynamicResource Theme.Font.BodyWeight}"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <local:ThemeShape DockPanel.Dock="Left" Slot="TitleGlyph" Kind="{DynamicResource Theme.Shapes.TitleGlyph}"
                                  Stroke="{DynamicResource Theme.Text.Glyph}" Gap="4" VerticalAlignment="Center"/>
                <TextBlock x:Name="DinoText" Text="Connecting…"
                           Foreground="{DynamicResource Theme.Text.Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource Theme.Font.TitleFamily}" FontWeight="{DynamicResource Theme.Font.TitleWeight}"/>
            </DockPanel>

            <!-- Footer: the status line, and the active view at its right end
                 (like the minimap's footer). The two overlay one cell; the view
                 name steps aside in code when a long status needs the room,
                 and a status longer than the line ends in an ellipsis. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="{DynamicResource Theme.Size.10}" FontWeight="{DynamicResource Theme.Font.BodyWeight}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="ViewText" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="{DynamicResource Theme.Size.10}" FontWeight="{DynamicResource Theme.Font.BodyWeight}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Fracture badges: ALWAYS present (dim when intact, lit when
                 fractured), so a fracture can never resize the panel. Each is
                 the theme's badge shape (Default's rounded box) behind its
                 text, painted in code (SetFractures). -->
            <StackPanel x:Name="FractureRow" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,7,0,0">
                <Grid Margin="0,0,6,0">
                    <local:ThemeShape x:Name="FracHead" Slot="Badge" Kind="{DynamicResource Theme.Shapes.Badge}"
                                      CornerRadius="{DynamicResource Theme.Corner.Badge}"/>
                    <TextBlock x:Name="FracHeadText" Text="HEAD" Margin="6,2"
                               FontSize="{DynamicResource Theme.Font.BadgeSize}" FontWeight="Bold"/>
                </Grid>
                <Grid Margin="0,0,6,0">
                    <local:ThemeShape x:Name="FracBody" Slot="Badge" Kind="{DynamicResource Theme.Shapes.Badge}"
                                      CornerRadius="{DynamicResource Theme.Corner.Badge}"/>
                    <TextBlock x:Name="FracBodyText" Text="BODY" Margin="6,2"
                               FontSize="{DynamicResource Theme.Font.BadgeSize}" FontWeight="Bold"/>
                </Grid>
                <Grid>
                    <local:ThemeShape x:Name="FracLegs" Slot="Badge" Kind="{DynamicResource Theme.Shapes.Badge}"
                                      CornerRadius="{DynamicResource Theme.Corner.Badge}"/>
                    <TextBlock x:Name="FracLegsText" Text="LEGS" Margin="6,2"
                               FontSize="{DynamicResource Theme.Font.BadgeSize}" FontWeight="Bold"/>
                </Grid>
            </StackPanel>

            <!-- The bars fill what is left: one of the two views is visible.
                 Each bar is a BarTrack (a theme's inset line round the empty
                 part, none in Default) holding its BarFill (a theme's halo
                 behind a critical bar, painted in code; none in Default). -->
            <Grid>

            <!-- ===== Survival view: health, stamina, hunger, thirst ===== -->
            <StackPanel x:Name="FullView" VerticalAlignment="Top">

            <!-- Health -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Health" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <local:BarTrack Grid.Column="1" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                        Background="{DynamicResource Theme.Bars.Health.Track}" VerticalAlignment="Center"
                        LineBrush="{DynamicResource Theme.Bars.Health.TrackLine}" LineWidth="{DynamicResource Theme.Bars.TrackLineWidth}">
                    <local:BarFill x:Name="HealthFill" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                            Background="{DynamicResource Theme.Bars.Health.Above75.Fill}"
                            HorizontalAlignment="Left" Width="0"/>
                </local:BarTrack>
                <TextBlock x:Name="HealthPct" Grid.Column="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Stamina -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stamina" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <local:BarTrack Grid.Column="1" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                        Background="{DynamicResource Theme.Bars.Stamina.Track}" VerticalAlignment="Center"
                        LineBrush="{DynamicResource Theme.Bars.Stamina.TrackLine}" LineWidth="{DynamicResource Theme.Bars.TrackLineWidth}">
                    <local:BarFill x:Name="StaminaFill" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                            Background="{DynamicResource Theme.Bars.Stamina.Above75.Fill}"
                            HorizontalAlignment="Left" Width="0"/>
                </local:BarTrack>
                <!-- Time until empty while draining, "full ~40s" while recovering (StaminaTracker). -->
                <TextBlock x:Name="StaminaLeft" Grid.Column="1" FontSize="{DynamicResource Theme.Size.10}" FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="StaminaPct" Grid.Column="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Hunger -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hunger" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <local:BarTrack Grid.Column="1" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                        Background="{DynamicResource Theme.Bars.Hunger.Track}" VerticalAlignment="Center"
                        LineBrush="{DynamicResource Theme.Bars.Hunger.TrackLine}" LineWidth="{DynamicResource Theme.Bars.TrackLineWidth}">
                    <local:BarFill x:Name="HungerFill" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                            Background="{DynamicResource Theme.Bars.Hunger.Above75.Fill}"
                            HorizontalAlignment="Left" Width="0"/>
                </local:BarTrack>
                <!-- Time left at the current drain rate: a data label riding the fill's tip
                     (positioned and coloured in code). Over the track, not in it, so the
                     12 px bar height can't clip the text. -->
                <TextBlock x:Name="HungerLeft" Grid.Column="1" FontSize="{DynamicResource Theme.Size.10}" FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="HungerPct" Grid.Column="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Thirst -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Thirst" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <local:BarTrack Grid.Column="1" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                        Background="{DynamicResource Theme.Bars.Thirst.Track}" VerticalAlignment="Center"
                        LineBrush="{DynamicResource Theme.Bars.Thirst.TrackLine}" LineWidth="{DynamicResource Theme.Bars.TrackLineWidth}">
                    <local:BarFill x:Name="ThirstFill" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                            Background="{DynamicResource Theme.Bars.Thirst.Above75.Fill}"
                            HorizontalAlignment="Left" Width="0"/>
                </local:BarTrack>
                <TextBlock x:Name="ThirstLeft" Grid.Column="1" FontSize="{DynamicResource Theme.Size.10}" FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="ThirstPct" Grid.Column="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            </StackPanel>

            <!-- ===== Combat view: the same four rows, different information =====
                 Health and stamina as in the survival view, then what matters in
                 a fight in place of hunger and thirst: damage taken in this fight
                 (a red bar that GROWS) and your speed (a number — there is no
                 honest full mark for a speed bar). Same sizes and positions as
                 the survival view, so flipping moves nothing. -->
            <StackPanel x:Name="CombatView" VerticalAlignment="Top" Visibility="Collapsed">

            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Health" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <local:BarTrack Grid.Column="1" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                        Background="{DynamicResource Theme.Bars.Health.Track}" VerticalAlignment="Center"
                        LineBrush="{DynamicResource Theme.Bars.Health.TrackLine}" LineWidth="{DynamicResource Theme.Bars.TrackLineWidth}">
                    <local:BarFill x:Name="CombatHealthFill" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                            Background="{DynamicResource Theme.Bars.Health.Above75.Fill}"
                            HorizontalAlignment="Left" Width="0"/>
                </local:BarTrack>
                <TextBlock x:Name="CombatHealthPct" Grid.Column="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stamina" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <local:BarTrack Grid.Column="1" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                        Background="{DynamicResource Theme.Bars.Stamina.Track}" VerticalAlignment="Center"
                        LineBrush="{DynamicResource Theme.Bars.Stamina.TrackLine}" LineWidth="{DynamicResource Theme.Bars.TrackLineWidth}">
                    <local:BarFill x:Name="CombatStaminaFill" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                            Background="{DynamicResource Theme.Bars.Stamina.Above75.Fill}"
                            HorizontalAlignment="Left" Width="0"/>
                </local:BarTrack>
                <TextBlock x:Name="CombatStaminaLeft" Grid.Column="1" FontSize="{DynamicResource Theme.Size.10}" FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="CombatStaminaPct" Grid.Column="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Damage taken in this fight: fills as you lose health, clears 30 s after the last hit -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Damage" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <local:BarTrack Grid.Column="1" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                        Background="{DynamicResource Theme.Bars.Damage.Track}" VerticalAlignment="Center"
                        LineBrush="{DynamicResource Theme.Bars.Damage.TrackLine}" LineWidth="{DynamicResource Theme.Bars.TrackLineWidth}">
                    <local:BarFill x:Name="DamageFill" Height="{DynamicResource Theme.Bars.Height}" CornerRadius="{DynamicResource Theme.Corner.Bar}"
                            Background="{DynamicResource Theme.Bars.Damage.Above75.Fill}"
                            HorizontalAlignment="Left" Width="0"/>
                </local:BarTrack>
                <TextBlock x:Name="DamagePct" Grid.Column="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Speed: a number, no bar (its top value changes with growth, so no scale would be true) -->
            <!-- No bar is the owner's call; the number comes from MainWindow's own short-window SpeedTracker. -->
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speed" Foreground="{DynamicResource Theme.Bars.Label}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SpeedValue" Grid.Column="1" Grid.ColumnSpan="2" Foreground="{DynamicResource Theme.Text.Text}" FontSize="{DynamicResource Theme.Size.11}"
                           FontWeight="{DynamicResource Theme.Font.ValueWeight}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            </StackPanel>

            </Grid>
        </DockPanel>
    </local:ThemedBorder>
</local:OverlayWindowBase>
