<Window x:Class="PandoraOverlay.GamesWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandoraOverlay"
        Title="{x:Static local:GamesText.WindowName}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource Theme.Glass.MapWindow}"
        FontFamily="{DynamicResource Theme.Font.Family}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated">

    <!-- The Games window (A11): its own opaque window, like the map's, never
         AllowsTransparency (moving content belongs in opaque windows: the
         map's perf spike). Its frame is the map window's look, the overlay's
         one opaque window look (A32, no token of its own): the theme's
         ThemedBorder on Glass.MapWindow, SQUARE, never cut (a cut could not
         show the game through an opaque window), never Lit (no edit mode);
         Windows 11's own rounding is the theme's flag (Map.WindowRounded,
         OnSourceInitialized). The root takes the fixed frame and the window
         sizes to it (GamesFrame); every word is GamesText's; every colour,
         corner and font a theme token.
         Its clicks (G27, A104): the root is in the Games scope, an inherited
         mark, so every control in the window clicks under the window's own mute
         and step and the Settings switch (A103); a game's view below is in the
         Game scope (GameHost), left to the Engine's rule (A105). A mark on a
         control says only what its type doesn't (PLAN-CLICKS.md, the appendix's
         Games window table); the warning's button and a tile's "Start it again"
         click by type (press). -->
    <local:ThemedBorder x:Name="RootPanel" local:UiClicks.Scope="Games" Background="{DynamicResource Theme.Glass.MapWindow}" BorderThickness="1"
                        Width="{x:Static local:GamesFrame.Width}" Height="{x:Static local:GamesFrame.Height}">
        <DockPanel>
            <!-- The header, always (G13): its bottom line inside its 40. -->
            <Border x:Name="Header" DockPanel.Dock="Top" Height="{x:Static local:GamesFrame.HeaderHeight}"
                    BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,0,0,1" Padding="{x:Static local:GamesFrame.HeaderPadding}">
                <DockPanel>
                    <!-- Right-aligned: the watch note (A16), the sound group (A82), the hint and ✕ (the update card's). -->
                    <StackPanel x:Name="HeaderRight" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="WatchNote" FontSize="{DynamicResource Theme.Size.11}" Foreground="{DynamicResource Theme.Text.Caution}"
                                   FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center" Margin="0,0,14,0"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <!-- The games' mute and volume (A82, A83): the speaker, −, five
                             level pips, +. Before the hint, so the watch note grows to its
                             left and the group never moves. Every size a GamesFrame
                             constant; the buttons not focusable, as the header's others,
                             so Esc and J keep working. The pips are built in code
                             (GamesWindow.xaml.cs), a meter, not a click. The glyphs at
                             body size 13: the speaker is 17.3 to 17.9 wide and 15.8 to
                             17.3 high in every bundled body font at its fit factor
                             (measured Nov 15 2026), inside the 22 x 22 with room to
                             spare; the planner's glyph render was at 13 too. The speaker's
                             glyphs at Normal in every theme, since a SemiBold body made WPF
                             embolden the fallback symbol font (A89).
                             No click of the layer's on any of the three (Cue None, A98,
                             PLAN-CLICKS.md 1.1's third rule): their sound is their own, a
                             mute is silence and an unmute or a step plays the preview at
                             the new step (A82), so a click on top would double it. -->
                        <StackPanel x:Name="SoundGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="{x:Static local:GamesFrame.SoundGroupMargin}">
                            <Button x:Name="SoundToggle" local:UiClicks.Cue="None" Click="SoundToggle_Click" Focusable="False" Style="{StaticResource NeutralButtonStyle}"
                                    Width="{x:Static local:GamesFrame.SoundButtonSize}" Height="{x:Static local:GamesFrame.SoundButtonSize}" Padding="0"
                                    FontSize="{DynamicResource Theme.Size.13}" FontWeight="Normal" VerticalAlignment="Center"/>
                            <Button x:Name="SoundDown" local:UiClicks.Cue="None" Click="SoundDown_Click" Focusable="False" Style="{StaticResource NeutralButtonStyle}"
                                    Content="{x:Static local:GamesText.SoundDown}" Margin="{x:Static local:GamesFrame.SoundGapBefore}"
                                    Width="{x:Static local:GamesFrame.SoundButtonSize}" Height="{x:Static local:GamesFrame.SoundButtonSize}" Padding="0"
                                    FontSize="{DynamicResource Theme.Size.13}" VerticalAlignment="Center"/>
                            <StackPanel x:Name="SoundPips" Orientation="Horizontal" VerticalAlignment="Center" Margin="{x:Static local:GamesFrame.SoundGapBefore}"
                                        Width="{x:Static local:GamesFrame.SoundPipsWidth}" Height="{x:Static local:GamesFrame.SoundPipsHeight}"/>
                            <Button x:Name="SoundUp" local:UiClicks.Cue="None" Click="SoundUp_Click" Focusable="False" Style="{StaticResource NeutralButtonStyle}"
                                    Content="{x:Static local:GamesText.SoundUp}" Margin="{x:Static local:GamesFrame.SoundGapBefore}"
                                    Width="{x:Static local:GamesFrame.SoundButtonSize}" Height="{x:Static local:GamesFrame.SoundButtonSize}" Padding="0"
                                    FontSize="{DynamicResource Theme.Size.13}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="HintText" Text="{x:Static local:GamesText.Hint}" FontSize="{DynamicResource Theme.Size.11}" Foreground="{DynamicResource Theme.Text.Dim}"
                                   FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <!-- ✕ and "‹ Games" are dismissals: back (A100). -->
                        <Button x:Name="CloseButton" local:UiClicks.Cue="Back" Content="{x:Static local:GamesText.Close}" Click="Close_Click" Focusable="False"
                                Style="{StaticResource DangerButtonStyle}" Width="22" Height="22" Padding="0" FontSize="{DynamicResource Theme.Size.10}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Left: "‹ Games" in a game, the title (a title's literal size, as the map's), the dim subtitle. -->
                    <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" local:UiClicks.Cue="Back" Click="Back_Click" Focusable="False" Style="{StaticResource NeutralButtonStyle}"
                                Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="{x:Static local:GamesText.Back}"/>
                        </Button>
                        <TextBlock x:Name="TitleText" FontSize="14" Foreground="{DynamicResource Theme.Text.Title}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Theme.Font.TitleFamily}" FontWeight="{DynamicResource Theme.Font.TitleWeight}"
                                   MaxWidth="{x:Static local:GamesFrame.TitleMaxWidth}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" FontSize="{DynamicResource Theme.Size.12}" Foreground="{DynamicResource Theme.Text.Dim}"
                                   FontWeight="{DynamicResource Theme.Font.BodyWeight}" VerticalAlignment="Center" Margin="10,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The view area, exactly the Contract's 798 x 510: the grid, or a
                 game's view, and the health warning over either. -->
            <Grid x:Name="ViewArea" Width="{x:Static local:GamesFrame.ViewWidth}" Height="{x:Static local:GamesFrame.ViewHeight}">
                <!-- The grid (G1, G19): tiles in the catalog's order, three to a
                     row, the scrollbar's room always kept at the right (the
                     tiles' panel is fixed and left-aligned, so a bar that
                     appears moves nothing). Tiles are built in code
                     (GamesWindow.Tiles.cs). -->
                <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ScrollViewer.Resources>
                        <!-- The app's dark bar, at its own 8 wide: WPF's theme style
                             under it still sets a MinWidth of the system's 17, which
                             would take more than the 10 kept for it (GamesFrame.
                             ScrollBarRoom) and push into the tiles' room. -->
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}">
                            <Setter Property="MinWidth" Value="0"/>
                        </Style>
                    </ScrollViewer.Resources>
                    <WrapPanel x:Name="Tiles" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>

                <!-- A game in the same frame (G13): its view's Root, filling the area.
                     In the Game scope (A104, A105): a game's own controls click by the
                     Engine's rule (not during a turn, not on top of its own cue), so
                     the app's class handler leaves every button inside at once and a
                     game's click is never decided twice. -->
                <Border x:Name="GameHost" local:UiClicks.Scope="Game" Visibility="Collapsed"/>

                <!-- The health warning (G18, A15): opaque over the view area, never the header. -->
                <Border x:Name="WarningPanel" Background="{DynamicResource Theme.Glass.MapWindow}" Visibility="Collapsed">
                    <Border Background="{DynamicResource Theme.InfoCard.Surface}" BorderBrush="{DynamicResource Theme.InfoCard.Line}" BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.Corner.Card}" Padding="28,22" Width="380"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:GamesText.WarningTitle}" FontSize="{DynamicResource Theme.Size.16}" Foreground="{DynamicResource Theme.Text.Danger}"
                                       FontWeight="{DynamicResource Theme.Font.TitleWeight}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WarningHealth" FontSize="{DynamicResource Theme.Size.13}" Foreground="{DynamicResource Theme.Text.Bright}"
                                       FontWeight="{DynamicResource Theme.Font.BodyWeight}" HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Static local:GamesText.WarningHint}" FontSize="{DynamicResource Theme.Size.12}" Foreground="{DynamicResource Theme.Text.Dim}"
                                       FontWeight="{DynamicResource Theme.Font.BodyWeight}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button x:Name="WarningButton" Click="WarningButton_Click" Focusable="False" Style="{StaticResource SaveButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,18,0,0">
                                <TextBlock x:Name="WarningButtonText" TextTrimming="CharacterEllipsis"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </DockPanel>
    </local:ThemedBorder>
</Window>
