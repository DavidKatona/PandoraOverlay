<Application x:Class="PandoraOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Shell/MainWindow.xaml">
    <Application.Resources>
        <!-- The shared control templates (Themes/Controls.xaml), app-wide so
             every window, popup and card finds them. The theme's own tokens
             are merged beside them by Theme.Apply (MainWindow, at start-up). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PandoraOverlay;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
