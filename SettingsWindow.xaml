<Window x:Class="PandoraOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora Overlay settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="660"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- The default button chrome paints the disabled state near-white
             regardless of Background, which glows on this dark dialog — so
             the Save button (disabled while a pasted cookie is invalid) gets
             a template with an explicit dark disabled look. -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E5E38"/>
            <Setter Property="Foreground" Value="#DFF3E2"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A7347"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E2A22"/>
                                <Setter Property="Foreground" Value="#5E7263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left-hand navigation: the control panel's glow look, left-aligned;
             the selected page's button is recoloured in code. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="HoverGlow" Background="#2EFFFFFF" CornerRadius="3"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA7B0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Slider rows share one label width so every slider in the dialog
             starts on the same x, whichever page it sits on. -->
        <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="140"/>
        </Style>

        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECF2F8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="46"/>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Link" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB2D9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Waypoint name box: the hotkey box's look, but editable. -->
        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A2129"/>
            <Setter Property="Foreground" Value="#ECF2F8"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="32"/>
        </Style>

        <!-- Minimal dark scrollbar for the waypoint list (the stock one is
             light and would glow on this dialog). Track + thumb, no arrows. -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#1A2129" CornerRadius="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#5E6B76" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#1A2129"/>
            <Setter Property="Foreground" Value="#ECF2F8"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F210151B" BorderBrush="#33FFFFFF"
            BorderThickness="1" Padding="16,12">
        <DockPanel>

            <!-- Title bar (draggable) -->
            <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                       Margin="0,0,0,8" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Click="Cancel_Click"
                        Width="22" Height="22" Padding="0"
                        Background="#552B2B" Foreground="#FFDDDD"
                        BorderThickness="0" FontSize="10"/>
                <TextBlock Text="Pandora Overlay settings"
                           Foreground="#ECF2F8" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Click="Cancel_Click"
                        Padding="14,5" Margin="0,0,8,0" FontSize="12"
                        Background="#2A3038" Foreground="#C7D1DA" BorderThickness="0"/>
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click"
                        Style="{StaticResource SaveButtonStyle}"/>
            </StackPanel>

            <!-- Nav on the left, one page on the right. Pages that aren't
                 selected are Hidden (not Collapsed) so the grid keeps the
                 tallest page's height and the dialog never jumps between pages. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Nav" Margin="0,0,12,0">
                    <Button Content="Account" Tag="Account" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Controls" Tag="Controls" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="General" Tag="General" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Stats panel" Tag="Stats" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Minimap" Tag="Minimap" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Prime tracker" Tag="Prime" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Waypoints" Tag="Waypoints" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="Pages">

            <!-- ============================ Account ======================== -->
            <StackPanel Tag="Account">
            <TextBlock Style="{StaticResource PageTitle}" Text="ACCOUNT"/>

            <TextBlock x:Name="CookieStatus" FontSize="12" TextWrapping="Wrap"/>

            <Button Content="Open live map in browser" Click="OpenMap_Click"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5"
                    Background="#264A63" Foreground="#DCEBF7" BorderThickness="0"
                    FontSize="12"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="HowToLink" Style="{StaticResource Link}"
                           Text="&#x25B8; How do I get my cookie?"
                           MouseLeftButtonDown="HowToLink_Click"/>
                <!-- Only once a cookie is stored: the paste box is the exception, not the rule. -->
                <TextBlock x:Name="ReplaceLink" Style="{StaticResource Link}"
                           Text="&#x25B8; Replace cookie…" Margin="18,0,0,0"
                           Visibility="Collapsed"
                           MouseLeftButtonDown="ReplaceLink_Click"/>
            </StackPanel>
            <TextBlock x:Name="HowToText" Visibility="Collapsed"
                       Foreground="#C7D1DA" FontSize="12" TextWrapping="Wrap"
                       LineHeight="19" Margin="0,4,0,0">
                1. Click "Open live map in browser" and log in with Discord.<LineBreak/>
                2. On the live-map page press F12, open the Network tab.<LineBreak/>
                3. Type "mylocation" into the filter box and click any row.<LineBreak/>
                4. Under Request Headers, copy the whole value of "cookie".
            </TextBlock>

            <StackPanel x:Name="CookiePanel">
                <TextBlock Text="Paste a cookie value to set or replace it:"
                           Foreground="#9AA7B0" FontSize="11" Margin="0,10,0,4"/>
                <TextBox x:Name="CookieBox"
                         Height="52"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         Background="#1A2129" Foreground="#ECF2F8"
                         BorderBrush="#33FFFFFF" BorderThickness="1"
                         Padding="6" FontSize="11" FontFamily="Consolas"
                         TextChanged="CookieBox_TextChanged"/>
            </StackPanel>
            <TextBlock x:Name="HintText" Visibility="Collapsed"
                       Foreground="#7B8790" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ============================ Controls ======================= -->
            <StackPanel Tag="Controls" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="CONTROLS"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Edit mode:" Width="150"/>
                <TextBox x:Name="EditHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Hide/show overlay:" Width="150"/>
                <TextBox x:Name="HideHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Minimap view toggle:" Width="150"/>
                <TextBox x:Name="ViewHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Heatmap toggle:" Width="150"/>
                <TextBox x:Name="HeatmapHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Check Prime:" Width="150"/>
                <TextBox x:Name="PrimeHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <TextBlock x:Name="HotkeyHint"
                       Text="Click a box, then press the combination you want."
                       Foreground="#7B8790" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ============================ General ======================== -->
            <!-- App-wide only. Anything about one widget goes on that widget's page. -->
            <StackPanel Tag="General" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="GENERAL"/>

            <CheckBox x:Name="StartupCheck" Style="{StaticResource Check}" Content="Start with Windows"/>
            <CheckBox x:Name="HideNotInGameCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Hide the overlay while not in-game"/>
            <DockPanel Margin="0,10,0,0">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Background opacity:"/>
                <TextBlock x:Name="OpacityLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1"
                        SmallChange="0.05" LargeChange="0.2" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <CheckBox x:Name="FadeCheck" Style="{StaticResource Check}" Width="140"
                          Content="Fade idle panels to"/>
                <TextBlock x:Name="FadeLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="FadeSlider" Minimum="0.2" Maximum="0.8"
                        SmallChange="0.05" LargeChange="0.2" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        IsEnabled="{Binding IsChecked, ElementName=FadeCheck}"
                        ValueChanged="FadeSlider_ValueChanged"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Stats panel ==================== -->
            <StackPanel Tag="Stats" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="STATS PANEL"/>

            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="ScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ScaleSlider_ValueChanged"/>
            </DockPanel>
            <CheckBox x:Name="TimeLeftCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                      Content="Show time left on the hunger and thirst bars"/>
            <CheckBox x:Name="LowStatChimeCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Chime when hunger or thirst drops under 20%"/>
            <CheckBox x:Name="GrowthChimeCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Chime at growth milestones (25 / 50 / 75 / 100%)"/>
            </StackPanel>

            <!-- ============================ Minimap ======================== -->
            <StackPanel Tag="Minimap" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="MINIMAP"/>

            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Size:"/>
                <TextBlock x:Name="MapSizeLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="MapSizeSlider" Minimum="160" Maximum="400"
                        SmallChange="10" LargeChange="40" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="MapSizeSlider_ValueChanged"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="View:"/>
                <RadioButton x:Name="ModeIsland" Style="{StaticResource Radio}" Content="Whole island"
                             GroupName="MapMode" Margin="14,0,0,0"/>
                <RadioButton x:Name="ModeCentered" Style="{StaticResource Radio}" Content="Player-centered"
                             GroupName="MapMode" Margin="14,0,0,0"/>
            </StackPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Centered zoom:"/>
                <TextBlock x:Name="ZoomLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="ZoomSlider" Minimum="1.25" Maximum="6"
                        SmallChange="0.25" LargeChange="1" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ZoomSlider_ValueChanged"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Trail:"/>
                <RadioButton x:Name="TrailOff" Style="{StaticResource Radio}" Content="Off"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail10" Style="{StaticResource Radio}" Content="10 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail30" Style="{StaticResource Radio}" Content="30 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail60" Style="{StaticResource Radio}" Content="60 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="ScaleBarCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                      Content="Show scale bar"/>
            <CheckBox x:Name="SpeedCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Show heading and speed"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Waypoints:"/>
                <RadioButton x:Name="WpAll" Style="{StaticResource Radio}" Content="All"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
                <RadioButton x:Name="WpTracked" Style="{StaticResource Radio}" Content="Tracked only"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
                <RadioButton x:Name="WpNearest" Style="{StaticResource Radio}" Content="Nearest 10"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
            </StackPanel>
            </StackPanel>

            <!-- ============================ Waypoints ===================== -->
            <!-- Edits go to a draft copy of the library; Save commits it. -->
            <StackPanel Tag="Waypoints" Visibility="Hidden">
            <DockPanel Margin="0,4,0,8">
                <TextBlock x:Name="WaypointCount" DockPanel.Dock="Right"
                           Foreground="#7B8790" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="WAYPOINTS" Margin="0"/>
            </DockPanel>
            <Grid Margin="0,0,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Name" Foreground="#7B8790" FontSize="10"/>
                <TextBlock Grid.Column="2" Text="Show" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Track" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
            </Grid>
            <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="WaypointRows" Margin="0,0,6,0"/>
            </ScrollViewer>
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="DeleteAllButton" DockPanel.Dock="Right" Content="Delete all" Click="DeleteAll_Click"
                        Padding="10,4" FontSize="11" Background="#552B2B" Foreground="#FFDDDD" BorderThickness="0"/>
                <TextBlock Text="Right-click the minimap in edit mode to add a waypoint where you click. Click a dot to change its colour."
                           Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Prime tracker ================== -->
            <StackPanel Tag="Prime" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="PRIME TRACKER"/>

            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="PrimeScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="PrimeScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="PrimeScaleSlider_ValueChanged"/>
            </DockPanel>
            </StackPanel>

                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
