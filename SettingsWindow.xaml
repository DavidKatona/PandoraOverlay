<Window x:Class="PandoraOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora Overlay setup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="470"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">

    <Border CornerRadius="10" Background="#F210151B" BorderBrush="#33FFFFFF"
            BorderThickness="1" Padding="16,12">
        <StackPanel>

            <!-- Title bar (draggable) -->
            <DockPanel MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,10"
                       Background="Transparent">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Click="Cancel_Click"
                        Width="22" Height="22" Padding="0"
                        Background="#552B2B" Foreground="#FFDDDD"
                        BorderThickness="0" FontSize="10"/>
                <TextBlock Text="Connect your Isla Pandora account"
                           Foreground="#ECF2F8" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Foreground="#C7D1DA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                       LineHeight="19">
                1. Click the button below and log in with Discord.<LineBreak/>
                2. On the live-map page press F12, open the Network tab.<LineBreak/>
                3. Type "mylocation" into the filter box and click any row.<LineBreak/>
                4. Under Request Headers, copy the whole value of "cookie".
            </TextBlock>

            <Button Content="Open live map in browser" Click="OpenMap_Click"
                    HorizontalAlignment="Left" Margin="0,4,0,12" Padding="12,5"
                    Background="#264A63" Foreground="#DCEBF7" BorderThickness="0"
                    FontSize="12"/>

            <TextBlock Text="Paste the cookie value here:" Foreground="#9AA7B0"
                       FontSize="11" Margin="0,0,0,4"/>

            <TextBox x:Name="CookieBox"
                     Height="64"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     Background="#1A2129" Foreground="#ECF2F8"
                     BorderBrush="#33FFFFFF" BorderThickness="1"
                     Padding="6" FontSize="11" FontFamily="Consolas"
                     TextChanged="CookieBox_TextChanged"/>

            <TextBlock x:Name="HintText"
                       Text="Waiting for a pasted cookie…"
                       Foreground="#7B8790" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click"
                        Padding="14,5" Margin="0,0,8,0" FontSize="12"
                        Background="#2A3038" Foreground="#C7D1DA" BorderThickness="0"/>
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click"
                        IsEnabled="False"
                        Padding="18,5" FontSize="12"
                        Background="#2E5E38" Foreground="#DFF3E2" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
