<Window x:Class="PandoraOverlay.SettingsWindow"
        xmlns:local="clr-namespace:PandoraOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora Overlay settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource Theme.Font.Family}"
        ShowInTaskbar="True">

    <!-- Every control's template is the app's (Themes/Controls.xaml, 1.39):
         the dialog's own copies moved there, on the theme's tokens, so the
         update card and the sign-in window share them. RULE as before: no
         stock chrome anywhere in this dialog; a new control kind gets a
         template there before it ships. -->

    <!-- The frame is the theme's (ThemedBorder): Default's is the rounded
         Border it always was; a theme may cut two corners (Cut.Dialog) and
         light them. Its glass is the dialog's, not a widget's (no opacity
         slider here). Its SIZE is fixed (SettingsFrame, 1.39: the owner's
         call, Oct 25 2026), the same in every theme, Default's 1.38 size;
         the window sizes to it, and the pages lay out inside. On a small
         screen it gives way to the work area (MaxHeight, set in code). -->
    <local:ThemedBorder x:Name="RootPanel"
                        Width="{x:Static local:SettingsFrame.Width}" Height="{x:Static local:SettingsFrame.Height}"
                        CornerRadius="{DynamicResource Theme.Corner.Dialog}" CutCorners="{DynamicResource Theme.Cut.Dialog}"
                        Background="{DynamicResource Theme.Glass.Dialog}" BorderThickness="1" Padding="16,12">
        <DockPanel>

            <!-- Title bar (draggable): the theme's title glyph (none in Default), the title. -->
            <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                       Margin="0,0,0,8" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Click="Close_Click"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="22" Height="22" Padding="0" FontSize="10"/>
                <local:ThemeShape DockPanel.Dock="Left" Slot="TitleGlyph" Kind="{DynamicResource Theme.Shapes.TitleGlyph}"
                                  Stroke="{DynamicResource Theme.Text.Glyph}" Gap="4"/>
                <TextBlock Text="Pandora Overlay settings"
                           Foreground="{DynamicResource Theme.Text.Title}" FontSize="14"
                           FontFamily="{DynamicResource Theme.Font.TitleFamily}" FontWeight="{DynamicResource Theme.Font.TitleWeight}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Buttons -->
            <!-- Docked outside the pages' ScrollViewer like the title bar: on a
                 small screen (MaxHeight = 92% of the work area) a page scrolls
                 and Close stays in view. Save and Cancel were here until 1.38:
                 every change applies at once now, and the line says so once
                 for every page. -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"
                        Style="{StaticResource NeutralButtonStyle}"/>
                <TextBlock Text="Changes apply as you make them. A click on the game closes this window."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>

            <!-- Nav on the left, one page on the right. Pages that aren't
                 selected are Hidden (not Collapsed), so the grid keeps the
                 tallest page's height, as when the tallest page set the
                 dialog's (until 1.39); the frame is fixed now, and every page
                 must fit inside it (SettingsFrame). -->
            <!-- Our own nav, not the stock TabControl: its light chrome doesn't
                 theme. The nav is grouped (owner, Oct 22 2026): the overlay's
                 own pages, then the website's pages under a caption, then
                 About. Widgets with few options share the Widgets page, one
                 captioned group each in the control panel's order with that
                 widget's own scale slider first; the minimap has the Maps
                 page, with the one setting it shares with the map. A new
                 widget adds a group to the Widgets page, or a page of its own
                 when its options would make that page taller than the
                 tallest one (the Tag is SetPage's key). What belongs in this
                 dialog: a PREFERENCE — a value, or an on/off decided once.
                 Something flipped mid-game belongs on the control panel or a
                 hotkey instead. Every change applies at once (1.38, the owner's
                 call: no Save or Cancel), the website's pages included. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Only the Buttons are pages: SetPage walks Nav's Buttons, so the
                     caption and the divider between them are left alone. -->
                <StackPanel x:Name="Nav" Margin="0,0,12,0">
                    <ToggleButton Content="Account" Tag="Account" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="General" Tag="General" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Themes" Tag="Themes" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Hotkeys" Tag="Hotkeys" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Widgets" Tag="Widgets" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Maps" Tag="Maps" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Waypoints" Tag="Waypoints" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Friends" Tag="Friends" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <TextBlock Style="{StaticResource NavCaption}" Text="ISLAPANDORA.EU"/>
                    <ToggleButton Content="Skins" Tag="Skins" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Dino storage" Tag="Storage" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <ToggleButton Content="Server rules" Tag="Rules" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Border Height="1" Background="{DynamicResource Theme.Nav.Divider}" Margin="12,8,12,8"/>
                    <ToggleButton Content="About" Tag="About" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="Pages">

            <!-- ============================ Account ======================== -->
            <!-- The in-app sign-in (v1.31, SettingsWindow.Account.cs): one button
                 that opens the website's own Discord login in the overlay's
                 sign-in window, and afterwards a card saying who is signed in.
                 The cookie paste box is gone — nobody should learn to copy a
                 session out of a browser. Signing in and out act at once, and
                 are saved on the spot. -->
            <StackPanel Tag="Account">
            <TextBlock Style="{StaticResource PageTitle}" Text="ACCOUNT"/>

            <TextBlock x:Name="AccountStatus" FontSize="12" TextWrapping="Wrap"/>

            <!-- Not signed in: the button, and what happens when it is clicked. -->
            <Border x:Name="SignInCard" Background="{DynamicResource Theme.InfoCard.Surface}" BorderBrush="{DynamicResource Theme.InfoCard.Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.Corner.Card}" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="SignInButton" DockPanel.Dock="Left" Content="Sign in with Discord"
                                Click="SignIn_Click" Style="{StaticResource DiscordButtonStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="Opens the website's own login in a small window. About a minute."
                                   Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource Theme.InfoCard.Line}" Margin="0,12,0,10"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Theme.Text.Good}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <TextBlock Foreground="{DynamicResource Theme.Text.Text2}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="You log in on Discord's page, as on islapandora.eu. Your password goes to Discord, never to the overlay — or skip typing it and scan the QR code with the Discord app."/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Theme.Text.Good}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <TextBlock Foreground="{DynamicResource Theme.Text.Text2}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="The overlay keeps only the website session, encrypted for your Windows user. Nothing to copy, nothing on the clipboard."/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Theme.Text.Good}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <TextBlock Foreground="{DynamicResource Theme.Text.Text2}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="Your Steam account must be linked on the website (one LinkID typed in game chat, once)."/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Signed in: who, and the two things to do about it. -->
            <Border x:Name="AccountCard" Background="{DynamicResource Theme.InfoCard.Surface}" BorderBrush="{DynamicResource Theme.InfoCard.Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.Corner.Card}" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="SignInAgainButton" Content="Sign in again" Click="SignIn_Click"
                                    Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                            <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click"
                                    Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                        <!-- The initial is the fallback: the avatar (SettingsWindow.Account.cs)
                             is drawn over it once a saved or downloaded copy is there. -->
                        <Grid DockPanel.Dock="Left" Width="40" Height="40" VerticalAlignment="Center">
                            <Border CornerRadius="{x:Static local:SettingsWindow.AvatarCircle}" Background="{x:Static local:SiteBrushes.Discord}">
                                <TextBlock x:Name="AccountInitial" Foreground="{x:Static local:SiteBrushes.DiscordText}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Ellipse x:Name="AccountAvatar" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountNameText" Foreground="{DynamicResource Theme.Text.Bright}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="on islapandora.eu" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11.5" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SteamText" Foreground="{DynamicResource Theme.Text.Text}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Signed in" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11.5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SignedInText" Foreground="{DynamicResource Theme.Text.Text}" FontSize="11.5" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="AccountHint" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ============================ General ======================== -->
            <!-- App-wide only. Anything about one widget goes on the Widgets page,
                 or the Maps page for the minimap. The chimes are here, not with
                 their widgets: each plays whether or not its widget is on
                 screen (owner, Oct 22 2026; the friend chime came from Friends,
                 the two stat chimes from the stats panel's page). -->
            <StackPanel Tag="General" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="GENERAL"/>

            <CheckBox x:Name="StartupCheck" Style="{StaticResource Check}" Content="Start with Windows"/>
            <CheckBox x:Name="HideNotInGameCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Hide the overlay while not in-game"/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="LOOK"/>
            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Background opacity:"/>
                <TextBlock x:Name="OpacityLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="OpacitySlider" Minimum="0.3" Maximum="1"
                        SmallChange="0.05" LargeChange="0.2" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </DockPanel>
            <!-- A checkbox that owns a slider sits on the slider's row, in the
                 140 px label slot, and the slider's IsEnabled follows it. -->
            <DockPanel Margin="0,8,0,0">
                <CheckBox x:Name="FadeCheck" Style="{StaticResource Check}" Width="140"
                          Content="Fade idle panels to"/>
                <TextBlock x:Name="FadeLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="FadeSlider" Minimum="0.2" Maximum="0.8"
                        SmallChange="0.05" LargeChange="0.2" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        IsEnabled="{Binding IsChecked, ElementName=FadeCheck}"
                        ValueChanged="FadeSlider_ValueChanged"/>
            </DockPanel>
            <!-- Positions only: sizes are readability preferences with a slider each. -->
            <DockPanel Margin="0,12,0,0">
                <Button x:Name="ResetPositionsButton" DockPanel.Dock="Left" Content="Reset positions" Click="ResetPositions_Click"
                        Style="{StaticResource NeutralButtonStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="Puts every panel back in the default layout: Prime tracker and Activity feed top-left, minimap and stats panel top-right, control panel bottom-centre. Sizes stay as they are."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>

            <TextBlock Style="{StaticResource SectionCaption}" Text="SOUNDS"/>
            <CheckBox x:Name="LowStatChimeCheck" Style="{StaticResource Check}"
                      Content="Chime when hunger or thirst drops under 20%"/>
            <CheckBox x:Name="GrowthChimeCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Chime at growth milestones (25 / 50 / 75 / 100%)"/>
            <CheckBox x:Name="FriendsChimeCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Chime when a friend spawns in"/>
            <TextBlock Text="Each one plays the Windows &quot;Exclamation&quot; sound."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ============================ Themes ========================= -->
            <!-- A page of its own after General (owner, Oct 25 2026): the list
                 grows with every theme, and the theme editor joins it in a
                 later release. One radio row per theme, built from the bundled
                 themes (SettingsWindow.Themes.cs), so a theme's file adds its
                 own row. A theme only paints: every window changes at once,
                 no size or position moves. -->
            <StackPanel Tag="Themes" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="THEMES"/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="THEME" Margin="0,0,0,6"/>
            <StackPanel x:Name="ThemeList"/>
            <TextBlock Text="Every window changes at once. Sizes and positions stay as they are."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ============================ Hotkeys ======================== -->
            <!-- In the default layout's order (1.38, OverlayConfig.DefaultHotkey):
                 the overlay itself (F1–F4), the widgets in the control panel's
                 order (F5–F8), the website (F9), the map (M). Was "Controls"
                 until 1.37: the name read like the control panel. -->
            <StackPanel Tag="Hotkeys" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="HOTKEYS"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Edit mode:" Width="150"/>
                <TextBox x:Name="EditHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Hide/show overlay:" Width="150"/>
                <TextBox x:Name="HideHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Stats view:" Width="150"/>
                <TextBox x:Name="StatsViewHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Minimap view:" Width="150"/>
                <TextBox x:Name="ViewHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <!-- Flips the heatmap of whichever map is on screen: the map's own
                 layer while it is open, else the minimap's (MainWindow.ToggleHeatmap). -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Heatmap:" Width="150"/>
                <TextBox x:Name="HeatmapHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Check Prime:" Width="150"/>
                <TextBox x:Name="PrimeHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <!-- The Skins page's "Apply again" from gameplay (1.38): the website's
                 page, so it comes after the widgets' keys. -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                        ToolTip="Applies your favourite skin for the dino you are on: star one on the Skins page">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Apply my skin:" Width="150"/>
                <TextBox x:Name="SkinHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <!-- "Map", never "big map": the internal name never reaches the
                 player (owner, Oct 9 2026). -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Map:" Width="150"/>
                <TextBox x:Name="BigMapHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <TextBlock x:Name="HotkeyHint"
                       Text="Click a box, then press the combination you want."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
            <!-- 1.38: an update keeps a player's keys (OverlayConfig.DefaultHotkey);
                 this moves them to the layout a fresh install gets. Two clicks:
                 it changes every key at once. -->
            <DockPanel Margin="0,14,0,0">
                <Button x:Name="DefaultKeysButton" DockPanel.Dock="Left" Content="Use the default keys" Click="DefaultKeys_Click"
                        Style="{StaticResource NeutralButtonStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="F1–F4 the overlay, F5–F8 the widgets in the control panel's order, F9 the website, M the map. Updating the overlay keeps the keys you have."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Widgets ======================== -->
            <!-- The widgets with a few options each, one captioned group per
                 widget in the control panel's order, its own Scale slider first
                 (owner, Oct 22 2026: the Prime tracker's page held one slider).
                 The minimap is on the Maps page. The control panel has a Scale
                 of its own since 1.37; it used to ride the stats panel's. -->
            <StackPanel Tag="Widgets" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="WIDGETS"/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="STATS PANEL" Margin="0,0,0,6"/>
            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="ScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="ScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ScaleSlider_ValueChanged"/>
            </DockPanel>
            <!-- The DEFAULT view (Survival / Combat, the owner's names); the
                 stats view hotkey and the control panel's View flip it mid-game. -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="View:"/>
                <RadioButton x:Name="StatsViewSurvival" Style="{StaticResource Radio}" Content="Survival"
                             GroupName="StatsView" Margin="14,0,0,0"/>
                <RadioButton x:Name="StatsViewCombat" Style="{StaticResource Radio}" Content="Combat"
                             GroupName="StatsView" Margin="14,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="TimeLeftCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                      Content="Show time left on the hunger, thirst and stamina bars"/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="PRIME TRACKER"/>
            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="PrimeScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="PrimeScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="PrimeScaleSlider_ValueChanged"/>
            </DockPanel>

            <!-- Your own events are ALWAYS in the feed — it is yours; friends'
                 events are the extra, one checkbox. A "Friends only / Friends
                 and me" radio pair shipped for a day and was replaced (Sep 28
                 2026), a leftover of the widget's friends-first origin. -->
            <TextBlock Style="{StaticResource SectionCaption}" Text="ACTIVITY"/>
            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="ActivityScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="ActivityScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ActivityScaleSlider_ValueChanged"/>
            </DockPanel>
            <CheckBox x:Name="ActivityFriendsCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                      Content="Include friends' events"/>
            <CheckBox x:Name="ActivityDamageCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Also note damage taken (at most one line per half minute)"/>
            <CheckBox x:Name="ActivityAreaCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Name the island's areas: entering one, and where you or a friend spawned"/>
            <!-- The full list of what the feed posts is the README's: the page keeps
                 what a choice here changes, the friends list's request included. -->
            <TextBlock Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="The feed keeps the last ten minutes of your own events. With friends' events included it also shows theirs, and the friends list is fetched while the widget is shown."/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="CONTROL PANEL"/>
            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="ControlPanelScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="ControlPanelScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ControlPanelScaleSlider_ValueChanged"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Maps =========================== -->
            <!-- The minimap's options, then the one setting the minimap and the
                 map share: the trail's length (owner, Oct 9 and Oct 22 2026).
                 The map has no settings of its own (the map as a widget was
                 turned down): its choices are its Layers menu. No heatmap on/off
                 here (removed Sep 2026): something flipped mid-game is not a
                 preference — the heatmap hotkey and the control panel's Heatmap
                 button own it. -->
            <StackPanel Tag="Maps" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="MAPS"/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="MINIMAP" Margin="0,0,0,6"/>
            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="MinimapScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="MinimapScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="MinimapScaleSlider_ValueChanged"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="View:"/>
                <RadioButton x:Name="ModeIsland" Style="{StaticResource Radio}" Content="Whole island"
                             GroupName="MapMode" Margin="14,0,0,0"/>
                <RadioButton x:Name="ModeCentered" Style="{StaticResource Radio}" Content="Player-centered"
                             GroupName="MapMode" Margin="14,0,0,0"/>
            </StackPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Centered zoom:"/>
                <TextBlock x:Name="ZoomLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider Style="{DynamicResource Theme.SliderStyle}" x:Name="ZoomSlider" Minimum="1.25" Maximum="6"
                        SmallChange="0.25" LargeChange="1" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ZoomSlider_ValueChanged"/>
            </DockPanel>
            <CheckBox x:Name="ScaleBarCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                      Content="Show scale bar"/>
            <CheckBox x:Name="SpeedCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Show heading and speed"/>
            <CheckBox x:Name="AreaCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Show the area you are in"
                      ToolTip="Names the area in the map's top-right corner. In edit mode it names the area under the cursor."/>
            <!-- Radio buttons, not a ComboBox: stock ComboBox chrome is light and ignores Background. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Waypoints:"/>
                <RadioButton x:Name="WpAll" Style="{StaticResource Radio}" Content="All"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
                <RadioButton x:Name="WpTracked" Style="{StaticResource Radio}" Content="Tracked only"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
                <RadioButton x:Name="WpNearest" Style="{StaticResource Radio}" Content="Nearest 10"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionCaption}" Text="BOTH MAPS"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Trail:"/>
                <RadioButton x:Name="TrailOff" Style="{StaticResource Radio}" Content="Off"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail10" Style="{StaticResource Radio}" Content="10 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail30" Style="{StaticResource Radio}" Content="30 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail60" Style="{StaticResource Radio}" Content="60 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Everything else on the map is in its Layers menu, at its top right."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ============================ Waypoints ===================== -->
            <!-- The rows edit the page's own copy of the library, copied into it
                 as they change (SettingsWindow.Apply.cs). -->
            <StackPanel Tag="Waypoints" Visibility="Hidden">
            <DockPanel Margin="0,4,0,8">
                <TextBlock x:Name="WaypointCount" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="WAYPOINTS" Margin="0"/>
            </DockPanel>
            <!-- The column labels; the side margins are set in code to match the cards below. -->
            <Grid x:Name="WaypointHeader" Margin="7,0,13,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Colour" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Name" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Show" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Track" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Delete" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
            </Grid>
            <!-- The bar's space is always reserved so the cards keep one width; the
                 bar itself fades out when there is nothing to scroll (DarkScrollBar).
                 The labels above live outside the scroll area, so the code keeps the
                 header exactly as wide as the list viewport (AlignWaypointHeader). -->
            <ScrollViewer x:Name="WaypointList" Height="260" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="WaypointRows" Margin="0,0,6,0"/>
            </ScrollViewer>
            <TextBlock x:Name="WaypointStatus" Foreground="{DynamicResource Theme.Text.Label}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportButton" Content="Import…" Click="Import_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="ExportButton" Content="Export…" Click="Export_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="DeleteAllButton" Content="Delete all" Click="DeleteAll_Click"
                            Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="Right-click the map in edit mode to add one; click a dot to recolour."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Friends ======================== -->
            <!-- Your side of the roster: the roster itself is the site's
                 (managed there), the nickname, colour, map and feed choices
                 are yours, edited on the page's own copy and applied as they
                 change. -->
            <StackPanel Tag="Friends" Visibility="Hidden">
            <DockPanel Margin="0,4,0,8">
                <TextBlock x:Name="FriendCount" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="FRIENDS" Margin="0"/>
            </DockPanel>
            <!-- The friend-spawn chime moved to General's Sounds (1.37): a friends
                 alert is not a widget option, and MainWindow plays it with the
                 widget hidden (owner, Sep 28 and Oct 22 2026). -->
            <CheckBox x:Name="FriendsMapCheck" Style="{StaticResource Check}"
                      Content="Show friends on the minimap"/>

            <!-- The column labels; the side margins are set in code to match the card below. -->
            <Grid x:Name="FriendHeader" Margin="7,14,13,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Colour" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Name" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Last seen" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Map" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Feed" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="Track" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="10" HorizontalAlignment="Center"/>
            </Grid>
            <ScrollViewer x:Name="FriendList" Height="200" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="FriendRows" Margin="0,0,6,0"/>
            </ScrollViewer>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Manage on islapandora.eu" Click="ManageFriends_Click"
                        Style="{StaticResource NeutralButtonStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="Names and colours here stay on this PC. Adding, removing and hiding your location happen on the website."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Skins ========================== -->
            <!-- The website's Patreon skins page as tiles (built in code). Apply
                 changes your dino's skin in game, like the site's own button. -->
            <StackPanel Tag="Skins" Visibility="Hidden">
            <DockPanel Margin="0,4,0,6">
                <TextBlock x:Name="SkinCount" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="PATREON SKINS" Margin="0"/>
            </DockPanel>
            <!-- Status on the left, "Apply your favourite" for your current dino on the
                 right; the row keeps its height so the list never shifts. -->
            <DockPanel Height="30" Margin="0,0,0,6">
                <Button x:Name="SkinFavouriteButton" DockPanel.Dock="Right" Click="SkinFavourite_Click"
                        Style="{StaticResource SaveButtonStyle}" Padding="10,4" FontSize="11"
                        MaxWidth="210" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Hidden"/>
                <TextBlock x:Name="SkinStatus" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SkinsAvailable" Style="{StaticResource Radio}" Content="Available"
                                 GroupName="SkinFilter" Checked="SkinFilter_Changed" Margin="14,0,0,0"/>
                    <RadioButton x:Name="SkinsAll" Style="{StaticResource Radio}" Content="All"
                                 GroupName="SkinFilter" Checked="SkinFilter_Changed" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Search:"/>
                <TextBox x:Name="SkinSearch" Style="{StaticResource TextBoxStyle}" Margin="10,0,0,0"
                         MaxLength="40" TextChanged="SkinSearch_TextChanged"/>
            </DockPanel>
            <ScrollViewer x:Name="SkinList" Height="290" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <WrapPanel x:Name="SkinTiles" Margin="0,0,6,0"/>
            </ScrollViewer>
            <!-- The note has its own line since the third button arrived: beside
                 three buttons it wrapped into a narrow column. Refresh asks for
                 the LIST again (one small request); Reload pictures discards the
                 saved thumbnails, so it is its own, knowingly pressed button. -->
            <TextBlock Text="Apply presses the same button as the website's Patreon page and changes your dino in game. Tiers and the cooldown are the server's."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="SkinRefreshButton" Content="Refresh" Click="SkinRefresh_Click"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"
                        ToolTip="Ask the server for the list of skins again"/>
                <Button x:Name="SkinReloadButton" Content="Reload pictures" Click="SkinReloadPictures_Click"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0" IsEnabled="False"
                        ToolTip="Discard the saved pictures and download each one again as its tile comes into view (about 5 MB apiece)"/>
                <Button Content="islapandora.eu/patreon" Click="OpenPatreonPage_Click"
                        Style="{StaticResource NeutralButtonStyle}"/>
            </StackPanel>
            </StackPanel>

            <!-- ============================ Dino storage =================== -->
            <!-- The website's /extras Dino Storage (SettingsWindow.Storage.cs): the
                 account's stored dinos as cards that open in place, Rename and
                 Delete acting at once like the website's own buttons, and where
                 each was stored on the island map. The list is asked for and
                 the cards built in code every time the page is opened, like
                 the website's page; the list's height keeps the page no
                 taller than the Skins page, so the dialog doesn't grow. -->
            <StackPanel Tag="Storage" Visibility="Hidden">
            <DockPanel Margin="0,4,0,6">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StorageCount" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" HorizontalAlignment="Right"/>
                    <Border x:Name="StorageSlotBar" Width="90" Height="3" Background="{DynamicResource Theme.Storage.SlotsTrack}"
                            HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="Collapsed">
                        <Border x:Name="StorageSlotFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource Theme.Storage.Slots}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="DINO STORAGE" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <!-- The status keeps its height so the list never shifts. -->
            <DockPanel Height="30" Margin="0,0,0,6">
                <TextBlock x:Name="StorageStatus" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer x:Name="StorageList" Height="331" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="StorageCards" Margin="0,0,6,0"/>
            </ScrollViewer>
            <!-- One line on purpose: every pixel of height went to the list, so an open card fits in it. -->
            <TextBlock Text="Rename and Delete send the same requests as the website's own buttons."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="StorageRefreshButton" Content="Refresh" Click="StorageRefresh_Click"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"
                        ToolTip="Ask the website for your storage again"/>
                <Button Content="islapandora.eu/extras" Click="OpenExtrasPage_Click"
                        Style="{StaticResource NeutralButtonStyle}"/>
            </StackPanel>
            </StackPanel>

            <!-- ============================ Server rules =================== -->
            <!-- Reference, not preferences: the bundled copy of the site's rules
                 page (ServerRules), pack limits first because "can we run five
                 Ceratos?" is the in-game question; your species is highlighted. -->
            <StackPanel Tag="Rules" Visibility="Hidden">
            <DockPanel Margin="0,4,0,6">
                <TextBlock x:Name="RulesStamp" DockPanel.Dock="Right"
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="SERVER RULES" Margin="0"/>
            </DockPanel>
            <TextBlock x:Name="RulesNote" Foreground="{DynamicResource Theme.Text.Label}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ScrollViewer x:Name="RulesList" Height="340" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="RulesContent" Margin="0,0,6,0"/>
            </ScrollViewer>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="islapandora.eu/rules" Click="OpenRulesPage_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Discord" Click="OpenDiscord_Click"
                            Style="{StaticResource NeutralButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="A copy of the website's rules page, kept with the app. When in doubt, the Discord rules win."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ About ========================= -->
            <!-- This copy of the overlay: version and flavour, updates, where the
                 settings live, the links (SettingsWindow.About.cs). -->
            <StackPanel Tag="About" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="ABOUT"/>

            <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource Theme.Text.Bright}" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="A fully external overlay for The Isle: Evrima on Isla Pandora. Everything it shows comes from the islapandora.eu website's own requests; it never touches the game."
                       Foreground="{DynamicResource Theme.Text.Label}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="UPDATES" Margin="0,16,0,4"/>
            <!-- The launch check is one request to GitHub; installing is always a click. -->
            <CheckBox x:Name="UpdateCheck" Style="{StaticResource Check}"
                      Content="Check for updates at launch (one request to GitHub)"/>
            <DockPanel Margin="0,8,0,0">
                <!-- "What's new" (1.32): the running version's notes in the update card. -->
                <!-- A button: the owner's pick over an underlined link on the version line. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="Check for updates now" Click="UpdateButton_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="WhatsNewButton" Content="What's new" Click="WhatsNew_Click"
                            Style="{StaticResource NeutralButtonStyle}"/>
                </StackPanel>
                <TextBlock x:Name="UpdateText" Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="Installing an update is always your click: the overlay downloads it, closes and comes back on the new version."/>
            </DockPanel>

            <TextBlock Style="{StaticResource SectionCaption}" Text="YOUR SETTINGS" Margin="0,16,0,4"/>
            <TextBlock x:Name="DataFolderText" Foreground="{DynamicResource Theme.Text.Text}" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
            <!-- "Import from an older copy…" was here (1.30–1.37), for the move
                 to %AppData%; cut in 1.38 (owner, Oct 24 2026): copies older than
                 1.30 can't connect since Oct 12, the first start still moves an
                 older copy's files by itself, and the README says how by hand. -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Open folder" Click="OpenDataFolder_Click"
                        Style="{StaticResource NeutralButtonStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="Settings with the encrypted cookie, waypoints, friends and the skin pictures."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>

            <!-- The log (1.36, AppLog): always written at quiet levels, kept on the PC.
                 Detailed log raises every category to Verbose; the per-category
                 levels are config.json's LogLevels only (owner, Oct 21 2026). -->
            <TextBlock Style="{StaticResource SectionCaption}" Text="LOG" Margin="0,16,0,4"/>
            <!-- One row and one line of words: the page must stay within the
                 tallest page's height, or the dialog grows on every page. -->
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Open log folder" Click="OpenLogFolder_Click"
                        Style="{StaticResource NeutralButtonStyle}" VerticalAlignment="Center"/>
                <CheckBox x:Name="DetailedLogCheck" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="12,0,0,0"
                          Content="Detailed log, for a problem report"/>
            </DockPanel>
            <TextBlock Text="Never sent anywhere; no cookie, names or positions. Attach the newest file to a report."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <TextBlock Style="{StaticResource SectionCaption}" Text="LINKS" Margin="0,16,0,4"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Releases" Click="OpenReleases_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Report a problem" Click="OpenIssues_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Discord" Click="OpenDiscord_Click"
                            Style="{StaticResource NeutralButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="Free and open source. Questions, bugs and ideas go to the GitHub issues."
                           Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
            <!-- The bundled fonts' credit (1.39; Rajdhani and Orbitron with the
                 Pandora theme): the SIL Open Font Licence asks for its licence to
                 travel with the font, and it does (the build copies each
                 Assets\Fonts\<family>\OFL.txt beside the program); this line says
                 so in every theme. ONE line in every theme's font: a second would
                 make About taller than the dialog's frame. "OFL.txt beside the
                 program" no longer fit once it named three fonts (Montserrat,
                 the widest, measured 413 of the 459 px; the README says where). -->
            <TextBlock Text="Fonts: Montserrat, Rajdhani, Orbitron (SIL Open Font Licence, see OFL.txt)."
                       Foreground="{DynamicResource Theme.Text.Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </local:ThemedBorder>
</Window>
