<Window x:Class="PandoraOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora Overlay settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="660"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- The default button chrome paints the disabled state near-white
             regardless of Background, which glows on this dark dialog — so
             the Save button (disabled while a pasted cookie is invalid) gets
             a template with an explicit dark disabled look. -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E5E38"/>
            <Setter Property="Foreground" Value="#DFF3E2"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A7347"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E2A22"/>
                                <Setter Property="Foreground" Value="#5E7263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral action button (Import/Export, pack Show/Hide all) with the
             same explicit disabled look. -->
        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A3038"/>
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A4250"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E242B"/>
                                <Setter Property="Foreground" Value="#5E6B76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same reason as SaveButtonStyle, in red: "Delete all" is disabled
             while the library is empty, and stock chrome paints that near-white. -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#552B2B"/>
            <Setter Property="Foreground" Value="#FFDDDD"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#6E3838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A2022"/>
                                <Setter Property="Foreground" Value="#6E5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Account page's one big button (v1.31): Discord's blurple, so it
             reads as "the Discord login" — which is exactly what it opens. -->
        <Style x:Key="DiscordButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4752C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#2B2F4A"/>
                                <Setter Property="Foreground" Value="#7A80A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left-hand navigation: the control panel's glow look, left-aligned;
             the selected page's button is recoloured in code. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="HoverGlow" Background="#2EFFFFFF" CornerRadius="3"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA7B0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Slider rows share one label width so every slider in the dialog
             starts on the same x, whichever page it sits on. -->
        <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="140"/>
        </Style>

        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECF2F8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="46"/>
        </Style>

        <!-- Dark checkbox and radio: the stock white glyphs float on this
             surface. A content-less box (the list rows) drops the label gap.
             IsChecked = null draws the "mixed" square (group checkboxes). -->
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="2"
                                    Background="#1A2129" BorderBrush="#5E6B76" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Path x:Name="Tick" Data="M 3,7.5 L 6,10.5 L 11,4" Stroke="#ECF2F8"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Visibility="Collapsed"/>
                                    <Rectangle x:Name="Mixed" Width="7" Height="7" Fill="#ECF2F8" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#9AA7B0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Mixed" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#9AA7B0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#242C36"/>
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C7D1DA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="15" Height="15" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="#1A2129" Stroke="#5E6B76" StrokeThickness="1"/>
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#ECF2F8" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#9AA7B0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="#242C36"/>
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Link" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB2D9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Waypoint name box: the hotkey box's look, but editable. -->
        <!-- Text boxes: the same dark well as the checkboxes. Stock chrome
             squares the corners and flashes Windows blue on hover, focus and
             selection — exactly when the eye is on the box. Hover lightens
             the border, focus turns it the text colour. -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A2129"/>
            <Setter Property="Foreground" Value="#ECF2F8"/>
            <Setter Property="BorderBrush" Value="#5E6B76"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#ECF2F8"/>
            <Setter Property="SelectionBrush" Value="#3A5A78"/>
            <Setter Property="SelectionOpacity" Value="0.7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9AA7B0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#ECF2F8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NameBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="32"/>
        </Style>

        <!-- Minimal dark scrollbar for the waypoint list (the stock one is
             light and would glow on this dialog). Track + thumb, no arrows. -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#1A2129" CornerRadius="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#5E6B76" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Nothing to scroll: keep the space, hide the bar. -->
                <DataTrigger Binding="{Binding Maximum, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Opacity" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Every scrollbar in the dialog (page, list, the cookie box's inner one) takes the dark look. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>

        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F210151B" BorderBrush="#33FFFFFF"
            BorderThickness="1" Padding="16,12">
        <DockPanel>

            <!-- Title bar (draggable) -->
            <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                       Margin="0,0,0,8" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Click="Cancel_Click"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="22" Height="22" Padding="0" FontSize="10"/>
                <TextBlock Text="Pandora Overlay settings"
                           Foreground="#ECF2F8" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click"
                        Style="{StaticResource SaveButtonStyle}"/>
            </StackPanel>

            <!-- Nav on the left, one page on the right. Pages that aren't
                 selected are Hidden (not Collapsed) so the grid keeps the
                 tallest page's height and the dialog never jumps between pages. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Nav" Margin="0,0,12,0">
                    <Button Content="Account" Tag="Account" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Controls" Tag="Controls" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="General" Tag="General" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Stats panel" Tag="Stats" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Minimap" Tag="Minimap" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Prime tracker" Tag="Prime" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Activity" Tag="Activity" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Friends" Tag="Friends" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Waypoints" Tag="Waypoints" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Skins" Tag="Skins" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Dino storage" Tag="Storage" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="Server rules" Tag="Rules" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <Button Content="About" Tag="About" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="Pages">

            <!-- ============================ Account ======================== -->
            <!-- The in-app sign-in (v1.31, SettingsWindow.Account.cs): one button
                 that opens the website's own Discord login in the overlay's
                 sign-in window, and afterwards a card saying who is signed in.
                 The cookie paste box is gone — nobody should learn to copy a
                 session out of a browser. Signing in and out ACT AT ONCE, not
                 on Save, like the Skins page; the page says so. -->
            <StackPanel Tag="Account">
            <TextBlock Style="{StaticResource PageTitle}" Text="ACCOUNT"/>

            <TextBlock x:Name="AccountStatus" FontSize="12" TextWrapping="Wrap"/>

            <!-- Not signed in: the button, and what happens when it is clicked. -->
            <Border x:Name="SignInCard" Background="#1B222A" BorderBrush="#333C46" BorderThickness="1"
                    CornerRadius="4" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="SignInButton" DockPanel.Dock="Left" Content="Sign in with Discord"
                                Click="SignIn_Click" Style="{StaticResource DiscordButtonStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="Opens the website's own login in a small window. About a minute."
                                   Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                    <Border Height="1" Background="#333C46" Margin="0,12,0,10"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7CC884" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <TextBlock Foreground="#C7D1DA" FontSize="11.5" TextWrapping="Wrap"
                                   Text="You log in on Discord's page, as on islapandora.eu. Your password goes to Discord, never to the overlay — or skip typing it and scan the QR code with the Discord app."/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7CC884" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <TextBlock Foreground="#C7D1DA" FontSize="11.5" TextWrapping="Wrap"
                                   Text="The overlay keeps only the website session, encrypted for your Windows user. Nothing to copy, nothing on the clipboard."/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7CC884" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <TextBlock Foreground="#C7D1DA" FontSize="11.5" TextWrapping="Wrap"
                                   Text="Your Steam account must be linked on the website (one LinkID typed in game chat, once)."/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Signed in: who, and the two things to do about it. -->
            <Border x:Name="AccountCard" Background="#1B222A" BorderBrush="#333C46" BorderThickness="1"
                    CornerRadius="4" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="SignInAgainButton" Content="Sign in again" Click="SignIn_Click"
                                    Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                            <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click"
                                    Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                        <!-- The initial is the fallback: the avatar (SettingsWindow.Account.cs)
                             is drawn over it once a saved or downloaded copy is there. -->
                        <Grid DockPanel.Dock="Left" Width="40" Height="40" VerticalAlignment="Center">
                            <Border CornerRadius="20" Background="#5865F2">
                                <TextBlock x:Name="AccountInitial" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Ellipse x:Name="AccountAvatar" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountNameText" Foreground="#ECF2F8" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="on islapandora.eu" Foreground="#7B8790" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam" Foreground="#7B8790" FontSize="11.5" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SteamText" Foreground="#C7D1DA" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Signed in" Foreground="#7B8790" FontSize="11.5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SignedInText" Foreground="#C7D1DA" FontSize="11.5" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="AccountHint" Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <!-- A fresh install lands here: the one pointer to the About page's import
                 (settings live in %AppData%\PandoraOverlay since 1.30). Shown only
                 while no cookie is stored. -->
            <TextBlock x:Name="ImportPointer" Style="{StaticResource Link}" Visibility="Collapsed"
                       Text="&#x25B8; Used the overlay before? Bring over your settings from the About page" Margin="0,16,0,0"
                       MouseLeftButtonDown="ImportPointer_Click"/>
            </StackPanel>

            <!-- ============================ Controls ======================= -->
            <StackPanel Tag="Controls" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="CONTROLS"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Edit mode:" Width="150"/>
                <TextBox x:Name="EditHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Hide/show overlay:" Width="150"/>
                <TextBox x:Name="HideHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Minimap view toggle:" Width="150"/>
                <TextBox x:Name="ViewHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Heatmap toggle:" Width="150"/>
                <TextBox x:Name="HeatmapHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Check Prime:" Width="150"/>
                <TextBox x:Name="PrimeHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Stats view toggle:" Width="150"/>
                <TextBox x:Name="StatsViewHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Map:" Width="150"/>
                <TextBox x:Name="BigMapHotkeyBox" Style="{StaticResource HotkeyBox}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotFocus"
                         LostKeyboardFocus="HotkeyBox_LostFocus"/>
            </StackPanel>
            <TextBlock x:Name="HotkeyHint"
                       Text="Click a box, then press the combination you want."
                       Foreground="#7B8790" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ============================ General ======================== -->
            <!-- App-wide only. Anything about one widget goes on that widget's page. -->
            <StackPanel Tag="General" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="GENERAL"/>

            <CheckBox x:Name="StartupCheck" Style="{StaticResource Check}" Content="Start with Windows"/>
            <CheckBox x:Name="HideNotInGameCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Hide the overlay while not in-game"/>
            <DockPanel Margin="0,10,0,0">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Background opacity:"/>
                <TextBlock x:Name="OpacityLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1"
                        SmallChange="0.05" LargeChange="0.2" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <CheckBox x:Name="FadeCheck" Style="{StaticResource Check}" Width="140"
                          Content="Fade idle panels to"/>
                <TextBlock x:Name="FadeLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="FadeSlider" Minimum="0.2" Maximum="0.8"
                        SmallChange="0.05" LargeChange="0.2" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        IsEnabled="{Binding IsChecked, ElementName=FadeCheck}"
                        ValueChanged="FadeSlider_ValueChanged"/>
            </DockPanel>
            <!-- Positions only: sizes are readability preferences with a slider each. -->
            <DockPanel Margin="0,14,0,0">
                <Button x:Name="ResetPositionsButton" DockPanel.Dock="Left" Content="Reset positions" Click="ResetPositions_Click"
                        Style="{StaticResource NeutralButtonStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="Puts every panel back in the default layout: Prime tracker and Activity feed top-left, minimap and stats panel top-right, control panel bottom-centre. Sizes stay as they are."
                           Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Stats panel ==================== -->
            <StackPanel Tag="Stats" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="STATS PANEL"/>

            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="ScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ScaleSlider_ValueChanged"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="View:"/>
                <RadioButton x:Name="StatsViewSurvival" Style="{StaticResource Radio}" Content="Survival"
                             GroupName="StatsView" Margin="14,0,0,0"/>
                <RadioButton x:Name="StatsViewCombat" Style="{StaticResource Radio}" Content="Combat"
                             GroupName="StatsView" Margin="14,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="TimeLeftCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                      Content="Show time left on the hunger, thirst and stamina bars"/>
            <CheckBox x:Name="LowStatChimeCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Chime when hunger or thirst drops under 20%"/>
            <CheckBox x:Name="GrowthChimeCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Chime at growth milestones (25 / 50 / 75 / 100%)"/>
            </StackPanel>

            <!-- ============================ Minimap ======================== -->
            <StackPanel Tag="Minimap" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="MINIMAP"/>

            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="MinimapScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="MinimapScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="MinimapScaleSlider_ValueChanged"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="View:"/>
                <RadioButton x:Name="ModeIsland" Style="{StaticResource Radio}" Content="Whole island"
                             GroupName="MapMode" Margin="14,0,0,0"/>
                <RadioButton x:Name="ModeCentered" Style="{StaticResource Radio}" Content="Player-centered"
                             GroupName="MapMode" Margin="14,0,0,0"/>
            </StackPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource SliderLabel}" Text="Centered zoom:"/>
                <TextBlock x:Name="ZoomLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="ZoomSlider" Minimum="1.25" Maximum="6"
                        SmallChange="0.25" LargeChange="1" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ZoomSlider_ValueChanged"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Trail:"/>
                <RadioButton x:Name="TrailOff" Style="{StaticResource Radio}" Content="Off"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail10" Style="{StaticResource Radio}" Content="10 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail30" Style="{StaticResource Radio}" Content="30 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
                <RadioButton x:Name="Trail60" Style="{StaticResource Radio}" Content="60 min"
                             GroupName="Trail" Margin="14,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="ScaleBarCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                      Content="Show scale bar"/>
            <CheckBox x:Name="SpeedCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Show heading and speed"/>
            <CheckBox x:Name="AreaCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Show the area you are in"
                      ToolTip="Names the area in the map's top-right corner. In edit mode it names the area under the cursor."/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Waypoints:"/>
                <RadioButton x:Name="WpAll" Style="{StaticResource Radio}" Content="All"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
                <RadioButton x:Name="WpTracked" Style="{StaticResource Radio}" Content="Tracked only"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
                <RadioButton x:Name="WpNearest" Style="{StaticResource Radio}" Content="Nearest 10"
                             GroupName="WpVisibility" Margin="14,0,0,0"/>
            </StackPanel>
            </StackPanel>

            <!-- ============================ Waypoints ===================== -->
            <!-- Edits go to a draft copy of the library; Save commits it. -->
            <StackPanel Tag="Waypoints" Visibility="Hidden">
            <DockPanel Margin="0,4,0,8">
                <TextBlock x:Name="WaypointCount" DockPanel.Dock="Right"
                           Foreground="#7B8790" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="WAYPOINTS" Margin="0"/>
            </DockPanel>
            <!-- The column labels; the side margins are set in code to match the cards below. -->
            <Grid x:Name="WaypointHeader" Margin="7,0,13,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Colour" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Name" Foreground="#7B8790" FontSize="10" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Show" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Track" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Delete" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
            </Grid>
            <!-- The bar's space is always reserved so the cards keep one width; the
                 bar itself fades out when there is nothing to scroll (DarkScrollBar).
                 The labels above live outside the scroll area, so the code keeps the
                 header exactly as wide as the list viewport (AlignWaypointHeader). -->
            <ScrollViewer x:Name="WaypointList" Height="260" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="WaypointRows" Margin="0,0,6,0"/>
            </ScrollViewer>
            <TextBlock x:Name="WaypointStatus" Foreground="#9AA7B0" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportButton" Content="Import…" Click="Import_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="ExportButton" Content="Export…" Click="Export_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="DeleteAllButton" Content="Delete all" Click="DeleteAll_Click"
                            Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="Right-click the map in edit mode to add one; click a dot to recolour."
                           Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Prime tracker ================== -->
            <StackPanel Tag="Prime" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="PRIME TRACKER"/>

            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="PrimeScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="PrimeScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="PrimeScaleSlider_ValueChanged"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Activity ======================= -->
            <StackPanel Tag="Activity" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="ACTIVITY"/>

            <DockPanel>
                <TextBlock Style="{StaticResource SliderLabel}" Text="Scale:"/>
                <TextBlock x:Name="ActivityScaleLabel" Style="{StaticResource SliderValue}" DockPanel.Dock="Right"/>
                <Slider x:Name="ActivityScaleSlider" Minimum="0.75" Maximum="1.5"
                        SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Margin="10,0,6,0"
                        ValueChanged="ActivityScaleSlider_ValueChanged"/>
            </DockPanel>
            <CheckBox x:Name="ActivityFriendsCheck" Style="{StaticResource Check}" Margin="0,10,0,0"
                      Content="Include friends' events"/>
            <CheckBox x:Name="ActivityDamageCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Also note damage taken (at most one line per half minute)"/>
            <CheckBox x:Name="ActivityAreaCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Name the island's areas: entering one, and where you or a friend spawned"/>
            <TextBlock Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="The feed keeps the last ten minutes of your own events: spawning in or starting a fresh dino, growth stages, low hunger or thirst, fractures, Prime check results and the areas you enter. With friends' events included it also shows friends spawning in or leaving, fresh dinos, growth stages, fractures and a friend coming near — and the friends list is fetched while the widget is shown."/>
            </StackPanel>

            <!-- ============================ Friends ======================== -->
            <!-- Your side of the roster: the roster itself is the site's
                 (managed there), the nickname, colour, map and feed choices
                 are yours and edited on a draft. -->
            <StackPanel Tag="Friends" Visibility="Hidden">
            <DockPanel Margin="0,4,0,8">
                <TextBlock x:Name="FriendCount" DockPanel.Dock="Right"
                           Foreground="#7B8790" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="FRIENDS" Margin="0"/>
            </DockPanel>
            <CheckBox x:Name="FriendsMapCheck" Style="{StaticResource Check}"
                      Content="Show friends on the minimap"/>
            <CheckBox x:Name="FriendsChimeCheck" Style="{StaticResource Check}" Margin="0,6,0,0"
                      Content="Chime when a friend spawns in"/>

            <!-- The column labels; the side margins are set in code to match the card below. -->
            <Grid x:Name="FriendHeader" Margin="7,14,13,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Colour" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Name" Foreground="#7B8790" FontSize="10" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Last seen" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Map" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Feed" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="Track" Foreground="#7B8790" FontSize="10" HorizontalAlignment="Center"/>
            </Grid>
            <ScrollViewer x:Name="FriendList" Height="200" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="FriendRows" Margin="0,0,6,0"/>
            </ScrollViewer>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Manage on islapandora.eu" Click="ManageFriends_Click"
                        Style="{StaticResource NeutralButtonStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="Names and colours here stay on this PC. Adding, removing and hiding your location happen on the website."
                           Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ Skins ========================== -->
            <!-- The website's Patreon skins page as tiles (built in code). The
                 one page that talks to the site, and the only thing in this
                 dialog that acts at once instead of on Save: Apply changes
                 your dino's skin in game, like the site's own button. -->
            <StackPanel Tag="Skins" Visibility="Hidden">
            <DockPanel Margin="0,4,0,6">
                <TextBlock x:Name="SkinCount" DockPanel.Dock="Right"
                           Foreground="#7B8790" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="PATREON SKINS" Margin="0"/>
            </DockPanel>
            <!-- Status on the left, "Apply again" for your current dino on the
                 right; the row keeps its height so the list never shifts. -->
            <DockPanel Height="30" Margin="0,0,0,6">
                <Button x:Name="SkinAgainButton" DockPanel.Dock="Right" Click="SkinAgain_Click"
                        Style="{StaticResource SaveButtonStyle}" Padding="10,4" FontSize="11"
                        MaxWidth="210" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Hidden"/>
                <TextBlock x:Name="SkinStatus" Foreground="#7B8790" FontSize="11" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SkinsAvailable" Style="{StaticResource Radio}" Content="Available"
                                 GroupName="SkinFilter" Checked="SkinFilter_Changed" Margin="14,0,0,0"/>
                    <RadioButton x:Name="SkinsAll" Style="{StaticResource Radio}" Content="All"
                                 GroupName="SkinFilter" Checked="SkinFilter_Changed" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Search:"/>
                <TextBox x:Name="SkinSearch" Style="{StaticResource TextBoxStyle}" Margin="10,0,0,0"
                         MaxLength="40" TextChanged="SkinSearch_TextChanged"/>
            </DockPanel>
            <ScrollViewer x:Name="SkinList" Height="290" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <WrapPanel x:Name="SkinTiles" Margin="0,0,6,0"/>
            </ScrollViewer>
            <!-- The note has its own line since the third button arrived: beside
                 three buttons it wrapped into a narrow column. Refresh asks for
                 the LIST again (one small request); Reload pictures discards the
                 saved thumbnails, so it is its own, knowingly pressed button. -->
            <TextBlock Text="Apply acts at once, not on Save: it presses the same button as the website's Patreon page. Tiers and the cooldown are the server's."
                       Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="SkinRefreshButton" Content="Refresh" Click="SkinRefresh_Click"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"
                        ToolTip="Ask the server for the list of skins again"/>
                <Button x:Name="SkinReloadButton" Content="Reload pictures" Click="SkinReloadPictures_Click"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0" IsEnabled="False"
                        ToolTip="Discard the saved pictures and download each one again as its tile comes into view (about 5 MB apiece)"/>
                <Button Content="islapandora.eu/patreon" Click="OpenPatreonPage_Click"
                        Style="{StaticResource NeutralButtonStyle}"/>
            </StackPanel>
            </StackPanel>

            <!-- ============================ Dino storage =================== -->
            <!-- The website's /extras Dino Storage (SettingsWindow.Storage.cs): the
                 account's stored dinos as cards that open in place, Rename and
                 Delete acting at once like the website's own buttons, and where
                 each was stored on the island map. The list is asked for and
                 the cards built in code every time the page is opened, like
                 the website's page; the list's height keeps the page no
                 taller than the Skins page, so the dialog doesn't grow. -->
            <StackPanel Tag="Storage" Visibility="Hidden">
            <DockPanel Margin="0,4,0,6">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StorageCount" Foreground="#7B8790" FontSize="11" HorizontalAlignment="Right"/>
                    <Border x:Name="StorageSlotBar" Width="90" Height="3" CornerRadius="1.5" Background="#262E37"
                            HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="Collapsed">
                        <Border x:Name="StorageSlotFill" Width="0" HorizontalAlignment="Left" CornerRadius="1.5" Background="#7B8790"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="DINO STORAGE" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <!-- The status keeps its height so the list never shifts. -->
            <DockPanel Height="30" Margin="0,0,0,6">
                <TextBlock x:Name="StorageStatus" Foreground="#7B8790" FontSize="11" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer x:Name="StorageList" Height="331" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="StorageCards" Margin="0,0,6,0"/>
            </ScrollViewer>
            <!-- One line on purpose: every pixel of height went to the list, so an open card fits in it. -->
            <TextBlock Text="Rename and Delete act at once, not on Save, like the website's own buttons."
                       Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="StorageRefreshButton" Content="Refresh" Click="StorageRefresh_Click"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"
                        ToolTip="Ask the website for your storage again"/>
                <Button Content="islapandora.eu/extras" Click="OpenExtrasPage_Click"
                        Style="{StaticResource NeutralButtonStyle}"/>
            </StackPanel>
            </StackPanel>

            <!-- ============================ Server rules =================== -->
            <!-- Reference, not preferences: the bundled copy of the site's rules
                 page (ServerRules), pack limits first because "can we run five
                 Ceratos?" is the in-game question; your species is highlighted. -->
            <StackPanel Tag="Rules" Visibility="Hidden">
            <DockPanel Margin="0,4,0,6">
                <TextBlock x:Name="RulesStamp" DockPanel.Dock="Right"
                           Foreground="#7B8790" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="SERVER RULES" Margin="0"/>
            </DockPanel>
            <TextBlock x:Name="RulesNote" Foreground="#9AA7B0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ScrollViewer x:Name="RulesList" Height="340" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="RulesContent" Margin="0,0,6,0"/>
            </ScrollViewer>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="islapandora.eu/rules" Click="OpenRulesPage_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Discord" Click="OpenDiscord_Click"
                            Style="{StaticResource NeutralButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="A copy of the website's rules page, kept with the app. When in doubt, the Discord rules win."
                           Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>

            <!-- ============================ About ========================= -->
            <!-- This copy of the overlay: version and flavour, updates, where the
                 settings live, the links (SettingsWindow.About.cs). -->
            <StackPanel Tag="About" Visibility="Hidden">
            <TextBlock Style="{StaticResource PageTitle}" Text="ABOUT"/>

            <TextBlock x:Name="AboutVersion" Foreground="#ECF2F8" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="A fully external overlay for The Isle: Evrima on Isla Pandora. Everything it shows comes from the islapandora.eu website's own requests; it never touches the game."
                       Foreground="#9AA7B0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock Text="UPDATES" Foreground="#7B8790" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <!-- The launch check is one request to GitHub; installing is always a click. -->
            <CheckBox x:Name="UpdateCheck" Style="{StaticResource Check}"
                      Content="Check for updates at launch (one request to GitHub)"/>
            <DockPanel Margin="0,8,0,0">
                <!-- "What's new" (1.32): the running version's notes in the update card. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="Check for updates now" Click="UpdateButton_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="WhatsNewButton" Content="What's new" Click="WhatsNew_Click"
                            Style="{StaticResource NeutralButtonStyle}"/>
                </StackPanel>
                <TextBlock x:Name="UpdateText" Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="Installing an update is always your click: the overlay downloads it, closes and comes back on the new version."/>
            </DockPanel>

            <TextBlock Text="YOUR SETTINGS" Foreground="#7B8790" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <TextBlock x:Name="DataFolderText" Foreground="#C7D1DA" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open folder" Click="OpenDataFolder_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="ImportSettingsButton" Content="Import from an older copy…" Click="ImportSettings_Click"
                            Style="{StaticResource NeutralButtonStyle}"/>
                </StackPanel>
                <TextBlock x:Name="ImportSettingsText"
                           Text="Settings with the encrypted cookie, waypoints, friends and the skin pictures. Import brings them over from a folder an older copy used."
                           Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>

            <TextBlock Text="LINKS" Foreground="#7B8790" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Releases" Click="OpenReleases_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Report a problem" Click="OpenIssues_Click"
                            Style="{StaticResource NeutralButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Discord" Click="OpenDiscord_Click"
                            Style="{StaticResource NeutralButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="Free and open source. Questions, bugs and ideas go to the GitHub issues."
                           Foreground="#7B8790" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
            </StackPanel>

                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
